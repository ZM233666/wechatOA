{
  "name": "mock-server",
  "version": "1.0.0",
  "private": true,
  "description": "开发阶段 Mock API Server，独立于正式 Django/DRF 后端；亦独立于已停扩的 NestJS 骨架",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "reset:runtime": "tsx scripts/reset-runtime.ts",
    "test": "vitest run",
    "test:start": "tsx scripts/smoke-start.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
