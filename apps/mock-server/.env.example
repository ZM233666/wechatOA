NODE_ENV=development
MOCK_HOST=0.0.0.0
MOCK_PORT=3100
API_PREFIX=/api
MOCK_PUBLIC_BASE_URL=
MOCK_DELAY_ENABLED=true
MOCK_DELAY_MIN=100
MOCK_DELAY_MAX=350
MOCK_DEFAULT_SCENARIO=normal
CORS_ORIGINS=*
# MOCK_NOW=2026-08-19T06:00:00.000Z

# MinIO（PDF 源：kb-insights / wetalk / suzhou/campus-map / suzhou/shuttle-bus）
# 控制台多为 :9001，S3 API 用 :9000
MINIO_ENABLED=true
MINIO_ENDPOINT=218.78.140.89
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
MINIO_BUCKET=wechat-official-account
MINIO_INSIGHTS_PREFIX=kb-insights/
MINIO_WETALK_PREFIX=wetalk/
MINIO_SUZHOU_CAMPUS_MAP_PREFIX=suzhou/campus-map/
MINIO_SUZHOU_SHUTTLE_BUS_PREFIX=suzhou/shuttle-bus/

# 新闻中心：从管理端 article-content 拉取（JWT /api/token/）
NEWS_ARTICLE_ENABLED=true
NEWS_ARTICLE_API_BASE_URL=http://127.0.0.1:8000
NEWS_ARTICLE_MEDIA_BASE_URL=http://127.0.0.1:8000
NEWS_ARTICLE_USERNAME=superadmin
NEWS_ARTICLE_PASSWORD=admin123456
NEWS_ARTICLE_INCLUDE_DRAFTS=false
NEWS_ARTICLE_LIMIT=50
NEWS_ARTICLE_MAX_IMAGES=40

# 品牌介绍：从 Django 拉取（公开接口未上线前自动回退管理端 JWT）
BRAND_INTRO_ENABLED=true
BRAND_INTRO_API_BASE_URL=http://127.0.0.1:8000
BRAND_INTRO_MEDIA_BASE_URL=http://127.0.0.1:8000
BRAND_INTRO_PUBLIC_PATH=/api/brand-intro/intro/public/current/
BRAND_INTRO_TRY_PUBLIC=true
BRAND_INTRO_USERNAME=superadmin
BRAND_INTRO_PASSWORD=admin123456

# 产品介绍（三系统）：公开 API 未上线前自动回退管理端 JWT
PRODUCT_INTRO_ENABLED=true
PRODUCT_INTRO_API_BASE_URL=http://127.0.0.1:8000
PRODUCT_INTRO_MEDIA_BASE_URL=http://127.0.0.1:8000
PRODUCT_INTRO_TRY_PUBLIC=true
PRODUCT_INTRO_USERNAME=superadmin
PRODUCT_INTRO_PASSWORD=admin123456

# 项目案例：从 Django project-case 拉取（JWT /api/token/）
PROJECT_CASE_ENABLED=true
PROJECT_CASE_API_BASE_URL=http://127.0.0.1:8000
PROJECT_CASE_MEDIA_BASE_URL=http://127.0.0.1:8000
PROJECT_CASE_USERNAME=superadmin
PROJECT_CASE_PASSWORD=admin123456
PROJECT_CASE_LIMIT=100
