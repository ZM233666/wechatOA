.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-state__icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #e8f0f8 0%, #fff8ed 100%);
  border: 2rpx solid var(--kb-divider);
}

.empty-state__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--kb-text);
  line-height: 1.4;
}

.empty-state__desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--kb-text-muted);
  line-height: 1.5;
}
