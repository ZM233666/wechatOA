<view class="skeleton">
  <block wx:if="{{variant === 'detail'}}">
    <view class="skeleton__cover"></view>
    <view class="skeleton__body">
      <view class="skeleton__line skeleton__line--short"></view>
      <view class="skeleton__line skeleton__line--title"></view>
      <view class="skeleton__line"></view>
      <view class="skeleton__line"></view>
      <view class="skeleton__line skeleton__line--mid"></view>
    </view>
  </block>

  <block wx:elif="{{variant === 'profile'}}">
    <view class="skeleton__profile">
      <view class="skeleton__avatar"></view>
      <view class="skeleton__line skeleton__line--title"></view>
      <view class="skeleton__line skeleton__line--short"></view>
      <view class="skeleton__menu"></view>
      <view class="skeleton__menu"></view>
    </view>
  </block>

  <block wx:else>
    <view class="skeleton__card" wx:for="{{[1, 2, 3]}}" wx:key="*this">
      <view class="skeleton__thumb"></view>
      <view class="skeleton__card-body">
        <view class="skeleton__line skeleton__line--short"></view>
        <view class="skeleton__line skeleton__line--title"></view>
        <view class="skeleton__line"></view>
      </view>
    </view>
  </block>
</view>
