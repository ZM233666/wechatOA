.skeleton {
  padding: 8rpx 0 24rpx;
}

.skeleton__cover,
.skeleton__thumb,
.skeleton__avatar,
.skeleton__line,
.skeleton__menu {
  background: linear-gradient(90deg, #e8edf3 25%, #f7f9fb 37%, #e8edf3 63%);
  background-size: 400% 100%;
  animation: skeleton-shimmer 1.4s ease infinite;
}

.skeleton__cover {
  width: 100%;
  height: 360rpx;
}

.skeleton__body,
.skeleton__profile {
  padding: 32rpx;
}

.skeleton__line {
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.skeleton__line--short {
  width: 28%;
  height: 24rpx;
}

.skeleton__line--title {
  width: 78%;
  height: 36rpx;
}

.skeleton__line--mid {
  width: 62%;
}

.skeleton__card {
  display: flex;
  gap: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.skeleton__thumb {
  width: 200rpx;
  height: 140rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.skeleton__card-body {
  flex: 1;
  padding-top: 8rpx;
}

.skeleton__avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  margin: 24rpx auto 28rpx;
}

.skeleton__profile .skeleton__line {
  margin-left: auto;
  margin-right: auto;
}

.skeleton__menu {
  height: 112rpx;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

@keyframes skeleton-shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
