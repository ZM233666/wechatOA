.app-header {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding: 8rpx 0 20rpx;
}

.app-header__main {
  flex: 1;
  min-width: 0;
}

.app-header__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--kb-navy-strong);
  line-height: 1.3;
}

.app-header__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--kb-text-muted);
  letter-spacing: 1rpx;
}

.app-header__action {
  margin-left: 16rpx;
  flex-shrink: 0;
}
