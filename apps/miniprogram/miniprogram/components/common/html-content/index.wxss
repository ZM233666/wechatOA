.html-content {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.75;
  word-break: break-word;
}

.html-content__empty {
  display: block;
  color: #9ca3af;
  font-size: 26rpx;
}

.html-content__carousel {
  margin: 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.html-content__swiper {
  width: 100%;
  height: 420rpx;
}

.html-content__slide {
  width: 100%;
  height: 420rpx;
  display: block;
}
