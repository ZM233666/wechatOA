.app-tab-bar__placeholder {
  height: calc(100rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.app-tab-bar__dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #ffffff;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}

.app-tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding-top: 8rpx;
}

.app-tab-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.app-tab-bar__text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #8a94a3;
}

.app-tab-bar__text--active {
  color: #003b70;
  font-weight: 600;
}
