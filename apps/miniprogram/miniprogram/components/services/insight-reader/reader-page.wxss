.reader-page {
  height: 100%;
  width: 100%;
  overflow: hidden;
  background: #ffffff;
  position: relative;
  box-sizing: border-box;
}

.reader-page--cover {
  background: #0f172a;
}

.reader-page--contents {
  background: #002a50;
}

.reader-page--sheet {
  background: #f7f3ea;
}

.reader-page__cover-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
}

.reader-page__cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.72));
}

.reader-page__cover-body {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 72rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.reader-page__card {
  align-self: flex-start;
  max-width: 78%;
  margin-top: 48rpx;
  padding: 28rpx 28rpx 28rpx 24rpx;
  background: rgba(31, 41, 55, 0.82);
  border-left: 8rpx solid #cda96a;
}

.reader-page__headline-line {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.reader-page__headline-en {
  display: block;
  margin-top: 18rpx;
  color: #cda96a;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.reader-page__cover-foot {
  margin-top: auto;
}

.reader-page__institute {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.22);
  margin-bottom: 10rpx;
}

.reader-page__brand {
  display: block;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.reader-page__contents {
  height: 100%;
  padding: 72rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.reader-page__contents-head {
  border: 2rpx solid #ffffff;
  padding: 14rpx 20rpx;
  margin-bottom: 48rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-end;
  align-self: flex-end;
}

.reader-page__contents-en {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.reader-page__contents-cn {
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.reader-page__toc {
  margin-bottom: 32rpx;
}

.reader-page__toc-title {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  margin-bottom: 10rpx;
}

.reader-page__toc-index {
  color: rgba(255, 255, 255, 0.45);
  font-size: 40rpx;
  font-weight: 300;
  margin-right: 14rpx;
  line-height: 1;
}

.reader-page__toc-en {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.reader-page__toc-cn {
  margin-left: 10rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  margin-bottom: 4rpx;
}

.reader-page__toc-line {
  display: block;
  margin-left: 54rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 1.65;
}

.reader-page__scroll {
  height: 100%;
}

.reader-page__body-image {
  width: 100%;
  height: 280rpx;
  display: block;
  background: #e5e7eb;
}

.reader-page__chapter {
  margin: -40rpx 28rpx 0;
  position: relative;
  z-index: 1;
  background: #003b70;
  color: #ffffff;
  padding: 18rpx 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.16);
}

.reader-page__chapter-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.reader-page__chapter-title {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.reader-page__body {
  padding: 28rpx 32rpx 40rpx;
}

.reader-page__paragraph {
  display: block;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.reader-page__bullet {
  display: block;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.65;
  margin-bottom: 8rpx;
}

.reader-page__sheet-stage {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f3ea;
  box-sizing: border-box;
}

.reader-page__sheet-fit {
  width: 100%;
  height: 100%;
  display: block;
  background: #f7f3ea;
}

.reader-page__map-area {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.reader-page__map-view {
  width: 100%;
  height: 100%;
}

.reader-page--map,
.reader-page--map.reader-page--sheet,
.reader-page--map .reader-page__sheet-stage,
.reader-page--map .reader-page__sheet-fit {
  background: #111111;
}
