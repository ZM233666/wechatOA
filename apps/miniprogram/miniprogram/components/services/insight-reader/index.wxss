.insight-reader {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #111111;
  box-sizing: border-box;
  overflow: hidden;
}

.insight-reader__error {
  padding-top: 120rpx;
}

.insight-reader__stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.insight-reader__chrome {
  position: absolute;
  z-index: 30;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  pointer-events: none;
}

.insight-reader__chrome--top {
  top: 12rpx;
}

.insight-reader__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.insight-reader__btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  border-radius: 32rpx;
  background: rgba(55, 65, 81, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  box-sizing: border-box;
}

.insight-reader__chrome .insight-reader__btn:first-child {
  margin-left: 0;
}

.insight-reader__share {
  width: 64rpx !important;
  min-width: 64rpx !important;
  max-width: 64rpx;
  height: 64rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  border: none;
  line-height: 1;
  background: rgba(55, 65, 81, 0.72);
  box-sizing: border-box;
}

.insight-reader__share::after {
  border: none;
}

.insight-reader__btn-text,
.insight-reader__btn-icon {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}

.insight-reader__btn-img {
  width: 32rpx;
  height: 32rpx;
  display: block;
  filter: brightness(0) invert(1);
}

.insight-reader__swiper {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: 12rpx 20rpx 0;
}

.insight-reader__page {
  height: 100%;
  border-radius: 8rpx;
  overflow: hidden;
  background: #ffffff;
  position: relative;
}

.insight-reader__page--cover {
  background: #0f172a;
}

.insight-reader__page--contents {
  background: #002a50;
}

.insight-reader__cover-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.55;
}

.insight-reader__cover-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(15, 23, 42, 0.35), rgba(15, 23, 42, 0.72));
}

.insight-reader__cover-body {
  position: relative;
  z-index: 1;
  height: 100%;
  padding: 72rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.insight-reader__card {
  align-self: flex-start;
  max-width: 78%;
  margin-top: 48rpx;
  padding: 28rpx 28rpx 28rpx 24rpx;
  background: rgba(31, 41, 55, 0.82);
  border-left: 8rpx solid #cda96a;
}

.insight-reader__card-bar {
  display: none;
}

.insight-reader__headline-line {
  display: block;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.insight-reader__headline-en {
  display: block;
  margin-top: 18rpx;
  color: #cda96a;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.insight-reader__cover-foot {
  margin-top: auto;
}

.insight-reader__institute {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.22);
  margin-bottom: 10rpx;
}

.insight-reader__brand {
  display: block;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.insight-reader__contents {
  height: 100%;
  padding: 72rpx 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.insight-reader__contents-head {
  border: 2rpx solid #ffffff;
  padding: 14rpx 20rpx;
  margin-bottom: 48rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-end;
  align-self: flex-end;
}

.insight-reader__contents-en {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.insight-reader__contents-cn {
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
  letter-spacing: 6rpx;
}

.insight-reader__toc {
  margin-bottom: 32rpx;
}

.insight-reader__toc-title {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  margin-bottom: 10rpx;
}

.insight-reader__toc-index {
  color: rgba(255, 255, 255, 0.45);
  font-size: 40rpx;
  font-weight: 300;
  margin-right: 14rpx;
  line-height: 1;
}

.insight-reader__toc-en {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.insight-reader__toc-cn {
  margin-left: 10rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  margin-bottom: 4rpx;
}

.insight-reader__toc-line {
  display: block;
  margin-left: 54rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  line-height: 1.65;
}

.insight-reader__scroll {
  height: 100%;
}

.insight-reader__body-image {
  width: 100%;
  height: 280rpx;
  display: block;
  background: #e5e7eb;
}

.insight-reader__chapter {
  margin: -40rpx 28rpx 0;
  position: relative;
  z-index: 1;
  background: #003b70;
  color: #ffffff;
  padding: 18rpx 22rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.16);
}

.insight-reader__chapter-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.insight-reader__chapter-title {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.insight-reader__body {
  padding: 28rpx 32rpx 40rpx;
}

.insight-reader__paragraph {
  display: block;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.65;
  margin-bottom: 20rpx;
}

.insight-reader__bullet {
  display: block;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.65;
  margin-bottom: 8rpx;
}

.insight-reader__nav {
  position: absolute;
  top: 46%;
  z-index: 30;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(55, 65, 81, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.insight-reader__nav--prev {
  left: 12rpx;
}

.insight-reader__nav--next {
  right: 12rpx;
}

.insight-reader__nav-icon {
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1;
  margin-top: -4rpx;
}

.insight-reader__dock {
  flex-shrink: 0;
  padding: 12rpx 24rpx 16rpx;
  background: #1f2937;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.insight-reader__meta {
  display: block;
  color: #9ca3af;
  font-size: 22rpx;
  margin-bottom: 14rpx;
}

.insight-reader__thumbs {
  white-space: nowrap;
  height: 104rpx;
}

.insight-reader__thumb {
  display: inline-flex;
  width: 96rpx;
  height: 96rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  overflow: hidden;
  opacity: 0.45;
  vertical-align: top;
}

.insight-reader__thumb--active {
  opacity: 1;
  box-shadow: 0 0 0 3rpx #ffffff;
}

.insight-reader__thumb-fill {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.insight-reader__thumb-fill--cover {
  background: #003b70;
}

.insight-reader__thumb-fill--contents {
  background: #374151;
}

.insight-reader__thumb-fill--content {
  background: #e5e7eb;
}

.insight-reader__thumb-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
}

.insight-reader__thumb-fill--content .insight-reader__thumb-text {
  color: #374151;
}
