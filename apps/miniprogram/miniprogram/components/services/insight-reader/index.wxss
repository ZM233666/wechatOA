.insight-reader {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #111111;
  box-sizing: border-box;
  overflow: hidden;
}

/* 父级 flex 列布局时撑满剩余空间，页码栏自然贴底 */
.insight-reader--fill {
  flex: 1;
  height: 0;
  min-height: 0;
}

.insight-reader--book {
  background:
    radial-gradient(120% 80% at 50% 18%, rgba(90, 70, 42, 0.35), transparent 55%),
    linear-gradient(180deg, #1a1612 0%, #0d0b09 48%, #14110e 100%);
}

.insight-reader__error {
  padding-top: 120rpx;
}

.insight-reader__stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.insight-reader__chrome {
  position: absolute;
  z-index: 40;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  pointer-events: none;
}

.insight-reader__chrome--top {
  top: 12px;
}

.insight-reader__actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: auto;
  gap: 16rpx;
}

.insight-reader__actions .insight-reader__btn {
  margin-left: 0;
}

.insight-reader__btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: 16rpx;
  border-radius: 32rpx;
  background: rgba(55, 65, 81, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
  box-sizing: border-box;
}

.insight-reader--book .insight-reader__chrome--top {
  /* 与胶囊同高区域，不压到内容 */
  height: 64rpx;
  align-items: center;
  padding-top: 0;
  padding-bottom: 0;
}

.insight-reader--book .insight-reader__btn {
  background: rgba(28, 22, 16, 0.72);
  border: 1rpx solid rgba(212, 175, 120, 0.28);
}

.insight-reader__chrome .insight-reader__btn:first-child {
  margin-left: 0;
}

.insight-reader__share {
  width: 64rpx !important;
  min-width: 64rpx !important;
  max-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: none;
  line-height: 1;
  background: rgba(55, 65, 81, 0.72);
  box-sizing: border-box;
}

.insight-reader--book .insight-reader__share {
  background: rgba(28, 22, 16, 0.72);
}

.insight-reader__share::after {
  border: none;
}

.insight-reader__btn-text,
.insight-reader__btn-icon {
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}

.insight-reader__btn-img {
  width: 32rpx;
  height: 32rpx;
  display: block;
  filter: brightness(0) invert(1);
}

/* —— 平铺模式（地图） —— */
.insight-reader__swiper {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
  padding: var(--header-inset, 64px) 20rpx 0;
}

.insight-reader__page-wrap {
  height: 100%;
  border-radius: 8rpx;
  overflow: hidden;
  background: #ffffff;
}

.insight-reader--map .insight-reader__swiper {
  padding: var(--header-inset, 64px) 0 0;
}

.insight-reader--map .insight-reader__page-wrap {
  border-radius: 0;
  background: #111111;
}

.insight-reader--no-dock .insight-reader__stage {
  flex: 1;
}

/* —— 翻书舞台 —— */
.book-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 与其他页 nav-brand 下沿对齐，避开状态栏/胶囊 */
  padding: var(--header-inset, 64px) 24rpx 16rpx;
  box-sizing: border-box;
  perspective: 1400px;
  overflow: hidden;
  touch-action: pan-y;
}

.book-stage__glow {
  position: absolute;
  left: 10%;
  right: 10%;
  top: 18%;
  bottom: 22%;
  border-radius: 40rpx;
  background: radial-gradient(ellipse at center, rgba(205, 169, 106, 0.14), transparent 70%);
  pointer-events: none;
  opacity: 0;
  transition: opacity 480ms ease;
}

.insight-reader--entered .book-stage__glow {
  opacity: 1;
}

.book-shell {
  position: relative;
  width: 100%;
  height: 100%;
  max-width: 720rpx;
  margin: 0 auto;
  transform: translateY(16rpx) scale(0.97);
  opacity: 0;
  transition:
    transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
    opacity 320ms ease;
  box-shadow:
    0 22rpx 48rpx rgba(0, 0, 0, 0.4),
    0 6rpx 14rpx rgba(0, 0, 0, 0.24);
  border-radius: 6rpx 14rpx 14rpx 6rpx;
  background: #1f1812;
}

.insight-reader--entered .book-shell {
  transform: translateY(0) scale(1);
  opacity: 1;
}

.book-shell--flipping {
  box-shadow:
    0 28rpx 56rpx rgba(0, 0, 0, 0.48),
    0 8rpx 16rpx rgba(0, 0, 0, 0.28);
}

.book-shell__spine {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 16rpx;
  z-index: 8;
  background: linear-gradient(
    90deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0.16) 45%,
    rgba(255, 255, 255, 0.08) 70%,
    transparent 100%
  );
  pointer-events: none;
  border-radius: 6rpx 0 0 6rpx;
}

.book-shell__edge--right {
  position: absolute;
  right: -8rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 10rpx;
  z-index: 0;
  border-radius: 0 10rpx 10rpx 0;
  background: linear-gradient(180deg, #c9b08a 0%, #8a6f4a 45%, #6d5638 100%);
  box-shadow: 2rpx 0 8rpx rgba(0, 0, 0, 0.22);
  pointer-events: none;
}

.book-leaf {
  position: absolute;
  inset: 0;
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  overflow: hidden;
  background: #f7f3ea;
}

.book-leaf--under {
  z-index: 1;
  box-shadow: inset 16rpx 0 24rpx rgba(0, 0, 0, 0.08);
}

.book-leaf--flip {
  z-index: 3;
  transform: rotateY(0deg);
  transform-origin: left center;
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  will-change: transform;
  touch-action: none;
}

.book-leaf--exit-next {
  transform-origin: left center !important;
  animation: book-exit-next 280ms cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

.book-leaf--exit-prev {
  transform-origin: right center !important;
  animation: book-exit-prev 280ms cubic-bezier(0.25, 0.8, 0.25, 1) forwards;
}

@keyframes book-exit-next {
  from { transform: rotateY(0deg); }
  to { transform: rotateY(-86deg); }
}

@keyframes book-exit-prev {
  from { transform: rotateY(0deg); }
  to { transform: rotateY(86deg); }
}

.book-leaf__face {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: inherit;
  background: #ffffff;
  /* 禁止子节点抢手势，保证滑动翻页 */
  pointer-events: none;
}

.book-leaf__curl {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 48rpx;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(0, 0, 0, 0.03) 40%,
    rgba(0, 0, 0, 0.12) 100%
  );
}

.book-leaf__shade {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.28), rgba(0, 0, 0, 0.05) 55%, transparent);
  transition: opacity 160ms linear;
}

.book-leaf__shade--on {
  opacity: 0.4;
}

.book-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 18rpx;
  display: flex;
  justify-content: center;
  pointer-events: none;
  opacity: 0;
  animation: book-hint-in 900ms 900ms ease both;
}

.book-hint__text {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(20, 16, 12, 0.55);
  color: rgba(245, 230, 205, 0.88);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  border: 1rpx solid rgba(212, 175, 120, 0.22);
}

@keyframes book-hint-in {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* —— 翻页按钮 —— */
.insight-reader__nav {
  position: absolute;
  top: 46%;
  z-index: 40;
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(55, 65, 81, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}

.insight-reader--book .insight-reader__nav {
  background: rgba(28, 22, 16, 0.78);
  border: 1rpx solid rgba(212, 175, 120, 0.28);
  backdrop-filter: blur(8px);
}

.insight-reader__nav--prev {
  left: 12rpx;
}

.insight-reader__nav--next {
  right: 12rpx;
}

.insight-reader__nav-icon {
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1;
  margin-top: -4rpx;
}

/* —— 底栏 —— */
.insight-reader__dock {
  flex-shrink: 0;
  padding: 10rpx 24rpx 12rpx;
  background: #1f2937;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}

.insight-reader__dock--book {
  background: linear-gradient(180deg, #1c1712 0%, #12100d 100%);
  border-top: 1rpx solid rgba(212, 175, 120, 0.16);
}

.insight-reader__dock-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  gap: 16rpx;
}

.insight-reader__meta {
  color: #9ca3af;
  font-size: 22rpx;
  flex-shrink: 0;
}

.insight-reader__dock--book .insight-reader__meta {
  color: rgba(212, 175, 120, 0.85);
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}

.insight-reader__title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
  color: rgba(245, 230, 205, 0.72);
  font-size: 20rpx;
}

.insight-reader__thumbs {
  white-space: nowrap;
  height: 104rpx;
}

.insight-reader__thumb {
  display: inline-flex;
  width: 96rpx;
  height: 96rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  overflow: hidden;
  opacity: 0.45;
  vertical-align: top;
}

.insight-reader--book .insight-reader__thumb {
  border-radius: 8rpx;
  opacity: 0.4;
  box-shadow: inset 0 0 0 1rpx rgba(212, 175, 120, 0.12);
}

.insight-reader__thumb--active {
  opacity: 1;
  box-shadow: 0 0 0 3rpx #ffffff;
}

.insight-reader--book .insight-reader__thumb--active {
  box-shadow: 0 0 0 3rpx rgba(212, 175, 120, 0.95);
  opacity: 1;
}

.insight-reader__thumb-fill {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.insight-reader__thumb-fill--cover {
  background: #003b70;
}

.insight-reader__thumb-fill--contents {
  background: #374151;
}

.insight-reader__thumb-fill--content {
  background: #e5e7eb;
}

.insight-reader__thumb-fill--sheet {
  background: #111827;
}

.insight-reader--book .insight-reader__thumb-fill--sheet {
  background: linear-gradient(145deg, #3a2f24, #1c1712);
}

.insight-reader__thumb-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
}

.insight-reader__thumb-fill--content .insight-reader__thumb-text {
  color: #374151;
}
