<view
  wx:if="{{visible}}"
  class="insight-reader"
  style="height: {{readerHeight}}px;"
>
  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在打开报告"></empty-state>
  <view wx:elif="{{pageStatus === 'error'}}" class="insight-reader__error" bindtap="onClose">
    <empty-state title="报告加载失败" description="{{errorText}}"></empty-state>
  </view>

  <block wx:elif="{{pageStatus === 'success' && report}}">
    <view class="insight-reader__stage">
      <view class="insight-reader__chrome insight-reader__chrome--top">
        <view class="insight-reader__btn tap-feedback" bindtap="onClose">
          <text class="insight-reader__btn-text">✕</text>
        </view>
        <view class="insight-reader__actions">
          <button class="insight-reader__btn insight-reader__share tap-feedback" open-type="share">
            <image
              class="insight-reader__btn-img"
              src="/assets/images/content/icon-share.png"
              mode="aspectFit"
            ></image>
          </button>
          <view class="insight-reader__btn tap-feedback" bindtap="onSave">
            <text class="insight-reader__btn-icon">⇩</text>
          </view>
        </view>
      </view>

      <swiper
        class="insight-reader__swiper"
        current="{{current}}"
        duration="{{360}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{pages}}" wx:key="id">
          <view class="insight-reader__page insight-reader__page--{{item.type}}">
            <block wx:if="{{item.type === 'cover'}}">
              <image
                wx:if="{{item.coverImage}}"
                class="insight-reader__cover-bg"
                src="{{item.coverImage}}"
                mode="aspectFill"
              ></image>
              <view class="insight-reader__cover-mask"></view>
              <view class="insight-reader__cover-body">
                <view class="insight-reader__card">
                  <view class="insight-reader__card-bar"></view>
                  <view class="insight-reader__headline">
                    <text
                      wx:for="{{item.headlineCn}}"
                      wx:for-item="line"
                      wx:key="*this"
                      class="insight-reader__headline-line"
                    >{{line}}</text>
                  </view>
                  <text class="insight-reader__headline-en">{{item.headlineEn}}</text>
                </view>
                <view class="insight-reader__cover-foot">
                  <text class="insight-reader__institute">{{item.institute}}</text>
                  <text class="insight-reader__brand">{{item.brand}}</text>
                </view>
              </view>
            </block>

            <block wx:elif="{{item.type === 'contents'}}">
              <view class="insight-reader__contents">
                <view class="insight-reader__contents-head">
                  <text class="insight-reader__contents-en">CONTENTS</text>
                  <text class="insight-reader__contents-cn">目录</text>
                </view>
                <view
                  class="insight-reader__toc"
                  wx:for="{{item.toc}}"
                  wx:for-item="toc"
                  wx:key="index"
                >
                  <view class="insight-reader__toc-title">
                    <text class="insight-reader__toc-index">{{toc.index}}</text>
                    <text class="insight-reader__toc-en">{{toc.titleEn}}</text>
                    <text class="insight-reader__toc-cn">{{toc.titleCn}}</text>
                  </view>
                  <text
                    class="insight-reader__toc-line"
                    wx:for="{{toc.lines}}"
                    wx:for-item="line"
                    wx:key="*this"
                  >{{line}}</text>
                </view>
              </view>
            </block>

            <block wx:else>
              <scroll-view scroll-y class="insight-reader__scroll">
                <image
                  wx:if="{{item.bodyImage}}"
                  class="insight-reader__body-image"
                  src="{{item.bodyImage}}"
                  mode="aspectFill"
                ></image>
                <view class="insight-reader__chapter">
                  <text class="insight-reader__chapter-label">{{item.chapterLabel}}</text>
                  <text class="insight-reader__chapter-title">{{item.chapterTitle}}</text>
                </view>
                <view class="insight-reader__body">
                  <text
                    class="insight-reader__paragraph"
                    wx:for="{{item.paragraphs}}"
                    wx:for-item="paragraph"
                    wx:key="*this"
                  >{{paragraph}}</text>
                  <view wx:if="{{item.bullets && item.bullets.length}}" class="insight-reader__bullets">
                    <text
                      class="insight-reader__bullet"
                      wx:for="{{item.bullets}}"
                      wx:for-item="bullet"
                      wx:key="*this"
                    >· {{bullet}}</text>
                  </view>
                </view>
              </scroll-view>
            </block>
          </view>
        </swiper-item>
      </swiper>

      <view
        wx:if="{{canPrev}}"
        class="insight-reader__nav insight-reader__nav--prev tap-feedback"
        bindtap="onPrev"
      >
        <text class="insight-reader__nav-icon">‹</text>
      </view>
      <view
        wx:if="{{canNext}}"
        class="insight-reader__nav insight-reader__nav--next tap-feedback"
        bindtap="onNext"
      >
        <text class="insight-reader__nav-icon">›</text>
      </view>
    </view>

    <view class="insight-reader__dock">
      <text class="insight-reader__meta">Page {{current + 1}} of {{pages.length}}</text>
      <scroll-view scroll-x class="insight-reader__thumbs" enable-flex="{{true}}">
        <view
          class="insight-reader__thumb tap-feedback {{current === index ? 'insight-reader__thumb--active' : ''}}"
          wx:for="{{pages}}"
          wx:key="id"
          data-index="{{index}}"
          bindtap="onThumbTap"
        >
          <view class="insight-reader__thumb-fill insight-reader__thumb-fill--{{item.thumbTone}}">
            <text class="insight-reader__thumb-text">{{item.thumbLabel}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
