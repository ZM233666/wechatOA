<wxs module="book" src="./book.wxs"></wxs>
<view
  wx:if="{{visible}}"
  class="insight-reader {{fillParent ? 'insight-reader--fill' : ''}} {{isMapMode ? 'insight-reader--map' : ''}} {{isBookMode ? 'insight-reader--book' : ''}} {{hideDock ? 'insight-reader--no-dock' : ''}} {{bookEntered ? 'insight-reader--entered' : ''}}"
  style="{{fillParent ? '' : 'height:' + readerHeight + 'px;'}}--header-inset: {{headerInset}}px;"
>
  <empty-state wx:if="{{pageStatus === 'loading'}}" title="{{isMapMode ? '正在打开园区地图' : (isBookMode ? '正在打开刊物' : '正在打开报告')}}"></empty-state>
  <view wx:elif="{{pageStatus === 'error'}}" class="insight-reader__error" bindtap="onClose">
    <empty-state title="{{isMapMode ? '地图加载失败' : '内容加载失败'}}" description="{{errorText}}"></empty-state>
  </view>

  <block wx:elif="{{pageStatus === 'success' && report}}">
    <view class="insight-reader__stage">
      <view
        class="insight-reader__chrome insight-reader__chrome--top"
        style="top: {{chromeTop}}px;"
      >
        <view class="insight-reader__btn tap-feedback" bindtap="onClose">
          <text class="insight-reader__btn-text">✕</text>
        </view>
        <view class="insight-reader__actions">
          <button class="insight-reader__btn insight-reader__share tap-feedback" open-type="share">
            <image
              class="insight-reader__btn-img"
              src="/assets/images/content/icon-share.png"
              mode="aspectFit"
            ></image>
          </button>
          <view class="insight-reader__btn tap-feedback" bindtap="onSave">
            <text class="insight-reader__btn-icon">⇩</text>
          </view>
        </view>
      </view>

      <view wx:if="{{isBookMode}}" class="book-stage">
        <view class="book-stage__glow"></view>
        <view class="book-shell {{flipping ? 'book-shell--flipping' : ''}}">
          <view class="book-shell__spine"></view>
          <view class="book-shell__edge book-shell__edge--right"></view>

          <view class="book-leaf book-leaf--under">
            <reader-page page="{{underPage}}"></reader-page>
            <view class="book-leaf__shade {{flipDirection ? 'book-leaf__shade--on' : ''}}"></view>
          </view>

          <!-- 手势绑在翻页叶上，WXS 直接改 transform -->
          <view
            class="book-leaf book-leaf--flip {{flipping ? (flipDirection === 'prev' ? 'book-leaf--exit-prev' : 'book-leaf--exit-next') : ''}}"
            data-gesture="{{bookGesture}}"
            change:data-gesture="{{book.syncProps}}"
            bindtouchstart="{{book.touchStart}}"
            bindtouchmove="{{book.touchMove}}"
            bindtouchend="{{book.touchEnd}}"
            bindtouchcancel="{{book.touchCancel}}"
          >
            <view class="book-leaf__face">
              <reader-page page="{{currentPage}}"></reader-page>
              <view class="book-leaf__curl"></view>
            </view>
          </view>
        </view>

        <view class="book-hint" wx:if="{{pages.length > 1 && !flipping && current === 0}}">
          <text class="book-hint__text">左右滑动翻页</text>
        </view>
      </view>

      <swiper
        wx:else
        class="insight-reader__swiper"
        current="{{current}}"
        duration="{{280}}"
        bindchange="onSwiperChange"
      >
        <swiper-item wx:for="{{pages}}" wx:key="id">
          <view class="insight-reader__page-wrap">
            <reader-page page="{{item}}" isMapMode="{{isMapMode}}"></reader-page>
          </view>
        </swiper-item>
      </swiper>

      <view
        wx:if="{{canPrev}}"
        class="insight-reader__nav insight-reader__nav--prev tap-feedback"
        catchtap="onPrev"
      >
        <text class="insight-reader__nav-icon">‹</text>
      </view>
      <view
        wx:if="{{canNext}}"
        class="insight-reader__nav insight-reader__nav--next tap-feedback"
        catchtap="onNext"
      >
        <text class="insight-reader__nav-icon">›</text>
      </view>
    </view>

    <view wx:if="{{!hideDock}}" class="insight-reader__dock {{isBookMode ? 'insight-reader__dock--book' : ''}}">
      <view class="insight-reader__dock-row">
        <text class="insight-reader__meta">{{current + 1}} / {{pages.length}}</text>
        <text wx:if="{{isBookMode && report.title}}" class="insight-reader__title">{{report.title}}</text>
      </view>
      <scroll-view scroll-x class="insight-reader__thumbs" enable-flex="{{true}}">
        <view
          class="insight-reader__thumb tap-feedback {{current === index ? 'insight-reader__thumb--active' : ''}}"
          wx:for="{{pages}}"
          wx:key="id"
          data-index="{{index}}"
          catchtap="onThumbTap"
        >
          <view class="insight-reader__thumb-fill insight-reader__thumb-fill--{{item.thumbTone}}">
            <text class="insight-reader__thumb-text">{{item.thumbLabel}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
