{
  "pages": [
    "pages/index/index",
    "pages/services/index",
    "pages/kb-life/index",
    "pages/profile/index"
  ],
  "subPackages": [
    {
      "root": "subpackages/services",
      "name": "services",
      "pages": [
        "my-dashboard/index",
        "insights/index",
        "insights/reader",
        "insights/access-denied/index"
      ]
    },
    {
      "root": "subpackages/kb-life",
      "name": "kb-life",
      "pages": [
        "campus-map/index",
        "shuttle-bus/index",
        "canteen/index",
        "holiday-calendar/index",
        "open-positions/index",
        "open-positions/detail",
        "guidance/index",
        "handbook/index",
        "financial-handbook/index",
        "financial-handbook/document/index",
        "care/index",
        "events/index",
        "events/highlight-moments/index",
        "events/highlight-moments/album/index"
      ]
    },
    {
      "root": "pages/news",
      "name": "news",
      "pages": ["index", "detail"]
    },
    {
      "root": "pages/brand",
      "name": "brand",
      "pages": ["index"]
    },
    {
      "root": "pages/products",
      "name": "products",
      "pages": ["index", "detail", "list"]
    },
    {
      "root": "pages/cases",
      "name": "cases",
      "pages": ["index", "detail"]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "wifi",
      "packages": ["news", "brand", "products", "cases"]
    },
    "pages/services/index": {
      "network": "all",
      "packages": ["services"]
    },
    "pages/kb-life/index": {
      "network": "all",
      "packages": ["kb-life"]
    }
  },
  "window": {
    "navigationBarTitleText": "Knorr-Bremse",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black",
    "backgroundTextStyle": "light",
    "backgroundColor": "#F5F7FA"
  },
  "tabBar": {
    "color": "#8A94A3",
    "selectedColor": "#003B70",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "Home",
        "iconPath": "assets/icons/tabbar/tab-home.png",
        "selectedIconPath": "assets/icons/tabbar/tab-home-active.png"
      },
      {
        "pagePath": "pages/services/index",
        "text": "Services",
        "iconPath": "assets/icons/tabbar/tab-services.png",
        "selectedIconPath": "assets/icons/tabbar/tab-services-active.png"
      },
      {
        "pagePath": "pages/kb-life/index",
        "text": "KB Life",
        "iconPath": "assets/icons/tabbar/tab-life.png",
        "selectedIconPath": "assets/icons/tabbar/tab-life-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "Setting",
        "iconPath": "assets/icons/tabbar/tab-profile.png",
        "selectedIconPath": "assets/icons/tabbar/tab-profile-active.png"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}
