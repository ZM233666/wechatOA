function stripPresignVersion(url) {
  var signed = url.indexOf('X-Amz-Signature=');
  if (signed < 0) {
    return url;
  }
  var mark = '&v=';
  var start = url.indexOf(mark);
  if (start < 0) {
    return url;
  }
  var rest = url.indexOf('&', start + 1);
  if (rest < 0) {
    return url.substring(0, start);
  }
  return url.substring(0, start) + url.substring(rest);
}

function imageSrc(url, apiBase) {
  if (!url) {
    return '';
  }
  url = stripPresignVersion(url);
  var marker = '/api/v1/mini/media/';
  var index = url.indexOf(marker);
  if (index < 0 || !apiBase) {
    return url;
  }
  var path = url.substring(index);
  var hash = path.indexOf('#');
  if (hash >= 0) {
    path = path.substring(0, hash);
  }
  var doubled = '/api/v1/mini/media/api/v1/mini/media/';
  var at = path.indexOf(doubled);
  while (at >= 0) {
    path = path.substring(0, at) + marker + path.substring(at + doubled.length);
    at = path.indexOf(doubled);
  }
  var base = apiBase;
  while (base.charAt(base.length - 1) === '/') {
    base = base.substring(0, base.length - 1);
  }
  return base + path;
}

module.exports = {
  imageSrc: imageSrc,
};
