<view class="page page--access-denied">
  <nav-brand title="{{navTitle}}" show-back="{{true}}"></nav-brand>

  <view class="denied">
    <view class="denied__icon">
      <text class="denied__icon-text">!</text>
    </view>
    <text class="denied__title">{{headline}}</text>
    <text wx:if="{{subtitle}}" class="denied__name">{{subtitle}}</text>
    <text class="denied__desc">{{desc}}</text>
    <text wx:if="{{descEn}}" class="denied__desc-en">{{descEn}}</text>
    <view wx:if="{{showBindButton}}" class="denied__btn tap-feedback" bindtap="onGoIdentityBinding">
      <text class="denied__btn-text">前往身份绑定</text>
    </view>
  </view>

  <app-tab-bar></app-tab-bar>
</view>
