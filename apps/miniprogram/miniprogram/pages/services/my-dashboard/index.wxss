page {
  background: #f5f7fa;
}

.page--my-dashboard {
  background: #f5f7fa;
  min-height: 100vh;
}

.dashboard {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.dashboard__heading {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 1.3;
}

.dashboard__hint {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.45;
}

.module-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
  display: flex;
  flex-direction: row;
  align-items: center;
}

.module-card__icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.module-card__icon {
  width: 40rpx;
  height: 40rpx;
}

.module-card__meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.module-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
}

.module-card__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.4;
}

.module-card__arrow {
  font-size: 36rpx;
  color: #9ca3af;
  line-height: 1;
  margin-left: 12rpx;
}
