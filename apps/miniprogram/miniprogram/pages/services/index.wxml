<view class="page page--services {{readerVisible ? 'page--services-reading' : ''}}">
  <nav-brand
    title="{{navTitle}}"
    show-back="{{listVisible && !readerVisible}}"
    back-as-event="{{listVisible}}"
    bind:back="onListBack"
  ></nav-brand>

  <insight-reader
    visible="{{readerVisible}}"
    report-id="{{readerReportId}}"
    with-tab-bar="{{true}}"
    bind:close="onReaderClose"
  ></insight-reader>

  <view wx:if="{{!readerVisible && listVisible}}" class="insights-panel">
    <empty-state wx:if="{{listStatus === 'loading'}}" title="正在加载洞察"></empty-state>
    <empty-state wx:elif="{{listStatus === 'error'}}" title="加载失败" description="{{listErrorText}}"></empty-state>
    <empty-state wx:elif="{{listStatus === 'empty'}}" title="暂无洞察报告"></empty-state>
    <view wx:if="{{listStatus === 'success'}}" class="insights-panel__grid">
      <view
        class="insight-cover tap-feedback"
        wx:for="{{insightItems}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-gating="{{item.gating}}"
        bindtap="onInsightTap"
      >
        <view class="insight-cover__frame">
          <view class="insight-cover__meta">
            <text class="insight-cover__kicker">{{item.kicker}}</text>
            <text class="insight-cover__name">{{item.title}}</text>
            <text class="insight-cover__en">{{item.english}}</text>
          </view>
          <image class="insight-cover__image" src="{{item.image}}" mode="aspectFill"></image>
          <text wx:if="{{item.tag}}" class="insight-cover__tag">{{item.tag}}</text>
        </view>
        <text class="insight-cover__caption">{{item.caption}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!readerVisible && !listVisible}}" class="services">
    <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载服务"></empty-state>
    <empty-state wx:elif="{{pageStatus === 'error'}}" title="服务加载失败" description="{{errorText}}"></empty-state>
    <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无服务内容"></empty-state>
    <block wx:if="{{pageStatus === 'success'}}">
    <view
      class="hero-card tap-feedback"
      wx:for="{{heroCards}}"
      wx:key="id"
      bindtap="onComingSoon"
    >
      <view class="hero-card__banner">
        <image class="hero-card__image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="hero-card__mask"></view>
        <view class="hero-card__top">
          <view class="hero-card__icon hero-card__icon--{{item.iconTone}}">
            <image class="hero-card__icon-img" src="{{item.icon}}" mode="aspectFit"></image>
          </view>
          <view wx:if="{{item.showOnline}}" class="hero-card__online">
            <view class="hero-card__online-dot"></view>
            <text class="hero-card__online-text">ONLINE</text>
          </view>
        </view>
        <view class="hero-card__titles">
          <text class="hero-card__title">{{item.title}}</text>
          <text class="hero-card__subtitle">{{item.subtitle}}</text>
        </view>
      </view>
      <view class="hero-card__footer">
        <view class="hero-card__footer-left">
          <text class="hero-card__footer-title">{{item.footerTitle}}</text>
          <text class="hero-card__footer-en">{{item.title}}</text>
        </view>
        <text class="hero-card__footer-hint">{{item.footerHint}}</text>
      </view>
    </view>

    <view class="insights-card">
      <view class="insights-card__head">
        <view class="insights-card__head-left">
          <view class="insights-card__bar"></view>
          <text class="insights-card__title">KB Insights</text>
        </view>
        <text class="insights-card__hint">智库与行业洞察</text>
      </view>

      <view class="insights-card__grid">
        <view
          class="insight-cover tap-feedback"
          wx:for="{{insightCovers}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-gating="{{item.gating}}"
          bindtap="onInsightTap"
        >
          <view class="insight-cover__frame">
            <view class="insight-cover__meta">
              <text class="insight-cover__kicker">{{item.kicker}}</text>
              <text class="insight-cover__name">{{item.title}}</text>
              <text class="insight-cover__en">{{item.english}}</text>
            </view>
            <image class="insight-cover__image" src="{{item.image}}" mode="aspectFill"></image>
            <text wx:if="{{item.tag}}" class="insight-cover__tag">{{item.tag}}</text>
          </view>
          <text class="insight-cover__caption">{{item.caption}}</text>
        </view>
      </view>

      <view class="insights-card__more tap-feedback" bindtap="onExploreMore">
        <text class="insights-card__more-text">探索更多</text>
      </view>
    </view>

    <view class="ask-btn tap-feedback" bindtap="onComingSoon">
      <text class="ask-btn__text">Have questions? Ask me anytime!</text>
    </view>
    </block>
  </view>
</view>
