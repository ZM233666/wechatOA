page {
  background: #f5f7fa;
}

.page--insights {
  min-height: 100vh;
  background: #f5f7fa;
}

.page--insights-reading {
  background: #111111;
}

.insights {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.insights__grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  background: linear-gradient(160deg, #f8fafc, #f1f5f9);
  border-radius: 24rpx;
  padding: 24rpx;
}

.insight-cover {
  width: 48%;
  margin-bottom: 28rpx;
}

.insight-cover__frame {
  position: relative;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  background: #ffffff;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  display: flex;
  flex-direction: column;
}

.insight-cover__meta {
  padding: 16rpx 16rpx 8rpx;
}

.insight-cover__kicker {
  display: block;
  font-size: 18rpx;
  color: #6b7280;
}

.insight-cover__name {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 1.3;
}

.insight-cover__en {
  display: block;
  margin-top: 6rpx;
  font-size: 16rpx;
  color: #9ca3af;
  line-height: 1.3;
}

.insight-cover__image {
  flex: 1;
  width: 100%;
  background: #f3f4f6;
}

.insight-cover__tag {
  position: absolute;
  top: 0;
  right: 16rpx;
  background: #cda96a;
  color: #ffffff;
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: 0 0 10rpx 10rpx;
}

.insight-cover__caption {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #1f2937;
  font-weight: 500;
  line-height: 1.35;
}
