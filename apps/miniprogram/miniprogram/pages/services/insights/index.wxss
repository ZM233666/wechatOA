page {
  background: #f5f7fa;
}

.page--insights {
  min-height: 100vh;
  background: #f5f7fa;
}

.page--insights-reading {
  background: #111111;
}

.insights {
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.insights__grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: flex-start;
  background: linear-gradient(160deg, #f8fafc, #f1f5f9);
  border-radius: 24rpx;
  padding: 24rpx 20rpx 8rpx;
}

.insight-cover {
  flex: 0 0 48%;
  width: 48%;
  max-width: 48%;
  min-width: 0;
  margin-bottom: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.insight-cover__frame {
  position: relative;
  width: 100%;
  height: 360rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.insight-cover__meta {
  position: relative;
  height: 148rpx;
  padding: 16rpx 16rpx 10rpx;
  padding-right: 72rpx;
  box-sizing: border-box;
  overflow: hidden;
  flex-shrink: 0;
}

.insight-cover__kicker {
  display: block;
  height: 24rpx;
  font-size: 18rpx;
  line-height: 24rpx;
  color: #6b7280;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.insight-cover__name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 6rpx;
  height: 64rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 32rpx;
}

.insight-cover__en {
  display: block;
  margin-top: 4rpx;
  height: 24rpx;
  font-size: 18rpx;
  color: #9ca3af;
  line-height: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.insight-cover__image {
  width: 100%;
  height: 212rpx;
  display: block;
  background: #e5e7eb;
  flex: none;
  flex-shrink: 0;
}

.insight-cover__tag {
  position: absolute;
  top: 0;
  right: 16rpx;
  z-index: 2;
  padding: 6rpx 12rpx;
  font-size: 16rpx;
  font-weight: 600;
  color: #ffffff;
  background: #cda96a;
  border-radius: 0 0 8rpx 8rpx;
}

.insight-cover__caption {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
  margin-top: 12rpx;
  height: 54rpx;
  text-align: center;
  font-size: 20rpx;
  color: #1f2937;
  font-weight: 500;
  line-height: 27rpx;
  flex-shrink: 0;
}
