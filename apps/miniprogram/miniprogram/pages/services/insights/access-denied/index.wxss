page {
  background: #f5f7fa;
}

.page--access-denied {
  min-height: 100vh;
  background: #f5f7fa;
}

.denied {
  padding: 80rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.denied__icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #fee2e2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.denied__icon-text {
  color: #dc2626;
  font-size: 56rpx;
  font-weight: 700;
}

.denied__title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.denied__name {
  font-size: 30rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 24rpx;
}

.denied__desc,
.denied__desc-en {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  max-width: 520rpx;
}

.denied__desc-en {
  margin-top: 8rpx;
}

.denied__btn {
  margin-top: 64rpx;
  width: 100%;
  background: #003b70;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
}

.denied__btn-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}
