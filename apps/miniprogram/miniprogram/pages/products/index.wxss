page {
  background: #ffffff;
}

.page--products {
  background: #ffffff;
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.product-search {
  margin: 24rpx 32rpx 32rpx;
  height: 88rpx;
  border: 4rpx solid #003b70;
  border-radius: 999rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  overflow: hidden;
}

.product-search__input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  color: #374151;
}

.product-search__placeholder {
  color: #9ca3af;
}

.product-search__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.product-search__btn {
  height: 88rpx;
  padding: 0 36rpx;
  background: #003b70;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.product-grid {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.product-tile {
  position: relative;
  width: 100%;
  height: 200rpx;
  margin-bottom: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.product-tile:last-child {
  margin-bottom: 0;
}

.product-tile__image {
  width: 100%;
  height: 100%;
  display: block;
}

.product-tile__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.product-tile__text {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.product-tile__cn {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.product-tile__en {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.product-contact {
  margin: 0 32rpx;
  background: #003b70;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.product-contact__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
}

.product-contact__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.product-contact__more {
  font-size: 26rpx;
  color: #ffffff;
}

.product-contact-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(17, 24, 39, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.product-contact-modal__panel {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 59, 112, 0.18);
}

.product-contact-modal__head {
  position: relative;
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(180deg, #f0f6fb 0%, #ffffff 100%);
  border-bottom: 1rpx solid #eef2f7;
}

.product-contact-modal__title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #003b70;
}

.product-contact-modal__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.product-contact-modal__close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(0, 59, 112, 0.08);
  color: #003b70;
  font-size: 40rpx;
  line-height: 56rpx;
  text-align: center;
}

.product-contact-modal__body {
  padding: 12rpx 32rpx 36rpx;
}

.product-contact-modal__item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}

.product-contact-modal__item:last-child {
  border-bottom: none;
}

.product-contact-modal__label {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.4;
}

.product-contact-modal__value {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.5;
}
