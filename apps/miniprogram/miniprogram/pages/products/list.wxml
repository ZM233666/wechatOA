<view class="page page--product-list">
  <nav-brand title="All Products" show-back="{{true}}"></nav-brand>

  <view class="product-list">
    <text class="product-list__heading">{{headingCn}} / {{headingEn}}</text>

    <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载产品"></empty-state>
    <view wx:elif="{{pageStatus === 'error'}}" bindtap="onRetry">
      <empty-state title="产品加载失败" description="{{errorText}}"></empty-state>
    </view>
    <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无产品" description="当前没有可展示的产品"></empty-state>

    <block wx:elif="{{pageStatus === 'success'}}">
      <view
        class="product-card"
        wx:for="{{products}}"
        wx:key="id"
      >
        <image
          class="product-card__image"
          src="{{item.image}}"
          mode="aspectFill"
          data-id="{{item.id}}"
          binderror="onProductImageError"
        ></image>
        <view class="product-card__body">
          <view class="product-card__meta">
            <text class="product-card__badge">{{item.categoryName}}</text>
            <text wx:if="{{item.featured}}" class="product-card__mark">核心产品</text>
          </view>
          <text class="product-card__name">{{item.name}}</text>
          <text class="product-card__summary">{{item.summary}}</text>
        </view>
      </view>

      <view wx:if="{{loadingMore}}" class="product-list__footer">加载中...</view>
      <view wx:elif="{{!hasNext && products.length}}" class="product-list__footer">已加载全部产品</view>
    </block>
  </view>
</view>
