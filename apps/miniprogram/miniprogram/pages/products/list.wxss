page {
  background: #f5f7fa;
}

.page--product-list {
  background: #f5f7fa;
  min-height: 100vh;
}

.product-list {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.product-list__heading {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 24rpx;
}

.product-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.product-card__image {
  width: 100%;
  height: 256rpx;
  display: block;
  background: #e5e7eb;
}

.product-card__body {
  padding: 28rpx;
}

.product-card__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.product-card__badge {
  font-size: 22rpx;
  color: #003b70;
  background: rgba(0, 59, 112, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.product-card__mark {
  font-size: 22rpx;
  color: #b45309;
  background: rgba(245, 158, 11, 0.12);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.product-card__name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 10rpx;
}

.product-card__summary {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.product-list__footer {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 16rpx 0 8rpx;
}
