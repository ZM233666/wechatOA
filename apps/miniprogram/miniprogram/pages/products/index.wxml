<view class="page page--products">
  <nav-brand title="Products" show-back="{{true}}"></nav-brand>
  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载产品"></empty-state>
  <view wx:elif="{{pageStatus === 'error'}}" bindtap="onRetry">
    <empty-state title="产品加载失败" description="{{errorText}}"></empty-state>
  </view>
  <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无产品" description="当前没有可展示的产品分类"></empty-state>
  <block wx:elif="{{pageStatus === 'success'}}">

  <view class="product-search">
    <input
      class="product-search__input"
      value="{{keyword}}"
      placeholder="可输入产品号、产品名称、参数等"
      placeholder-class="product-search__placeholder"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearch"
    />
    <image class="product-search__icon" src="/assets/images/kb-life/search.png" mode="aspectFit"></image>
    <view class="product-search__btn tap-feedback" bindtap="onSearch">查询</view>
  </view>

  <view class="product-grid">
    <view
      class="product-tile tap-feedback"
      wx:for="{{categories}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <image class="product-tile__image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="onCategoryImageError"></image>
      <view class="product-tile__mask"></view>
      <view class="product-tile__text">
        <text class="product-tile__cn">{{item.titleCn}}</text>
        <text class="product-tile__en">{{item.subtitleEn}}</text>
      </view>
    </view>
  </view>

  <view class="product-contact tap-feedback" bindtap="onContact">
    <view class="product-contact__text">
      <text class="product-contact__title">联系我们</text>
      <text class="product-contact__sub">业务咨询与支持</text>
    </view>
    <text class="product-contact__more">查看 ›</text>
  </view>
  </block>

  <view
    wx:if="{{contactVisible}}"
    class="product-contact-modal"
    catchtap="onCloseContact"
  >
    <view class="product-contact-modal__panel" catchtap="onContactPanelTap">
      <view class="product-contact-modal__head">
        <text class="product-contact-modal__title">联系我们</text>
        <text class="product-contact-modal__subtitle">Contact Us</text>
        <view class="product-contact-modal__close tap-feedback" catchtap="onCloseContact">×</view>
      </view>

      <view class="product-contact-modal__body">
        <view class="product-contact-modal__item">
          <text class="product-contact-modal__label">电话 / Phone</text>
          <text class="product-contact-modal__value">{{contactInfo.phone}}</text>
        </view>
        <view class="product-contact-modal__item">
          <text class="product-contact-modal__label">邮箱 / Email</text>
          <text class="product-contact-modal__value">{{contactInfo.email}}</text>
        </view>
        <view class="product-contact-modal__item">
          <text class="product-contact-modal__label">地址 / Address</text>
          <text class="product-contact-modal__value">{{contactInfo.address}}</text>
        </view>
        <view class="product-contact-modal__item">
          <text class="product-contact-modal__label">工作时间 / Business Hours</text>
          <text class="product-contact-modal__value">{{contactInfo.hours}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
