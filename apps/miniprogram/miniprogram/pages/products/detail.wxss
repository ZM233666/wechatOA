page {
  background: #ffffff;
}

.page--product-detail {
  background: #ffffff;
  min-height: 100vh;
}

.product-detail {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.product-detail__title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

.product-detail__cover {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  display: block;
  margin-bottom: 24rpx;
  background: #f3f4f6;
}

.product-detail__desc {
  display: block;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
  margin-bottom: 40rpx;
}

.product-detail__section {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
}

.core-item {
  background: #f9fafb;
  border: 1rpx solid #f3f4f6;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: row;
}

.core-item__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #e5e7eb;
}

.core-item__meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.core-item__name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 8rpx;
}

.core-item__desc {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.5;
}

.product-detail__btn {
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.product-detail__btn--primary {
  background: #003b70;
  color: #ffffff;
  margin-top: 32rpx;
}

.product-detail__btn--ghost {
  background: #f3f4f6;
  color: #003b70;
}

.product-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}
