<view class="page page--brand">
  <nav-brand title="Brand Intro" show-back="{{true}}"></nav-brand>

  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载品牌介绍"></empty-state>
  <view wx:elif="{{pageStatus === 'error'}}" bindtap="onRetry">
    <empty-state title="品牌加载失败" description="{{errorText}}"></empty-state>
  </view>
  <empty-state
    wx:elif="{{pageStatus === 'empty'}}"
    title="暂无已发布的品牌介绍"
    description="请稍后再试或联系管理员发布内容"
  ></empty-state>
  <block wx:elif="{{pageStatus === 'success'}}">
    <image wx:if="{{hero}}" class="brand-hero" src="{{hero}}" mode="aspectFill"></image>

    <view class="brand-body">
      <text class="brand-title">{{companyName}}</text>
      <text wx:if="{{intro}}" class="brand-intro">{{intro}}</text>

      <view wx:if="{{vision}}" class="brand-card">
        <text class="brand-card__title">Our Vision</text>
        <text class="brand-card__text">{{vision}}</text>
      </view>

      <view wx:if="{{values.length}}" class="brand-card">
        <text class="brand-card__title">Our Values</text>
        <view class="brand-values">
          <view class="brand-value" wx:for="{{values}}" wx:key="title">
            <text class="brand-value__title">{{item.title}}</text>
            <text class="brand-value__desc">{{item.description}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{brands.length}}" class="brand-card">
        <text class="brand-card__title">Core Brands</text>
        <view class="brand-tags">
          <text class="brand-tag" wx:for="{{brands}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
