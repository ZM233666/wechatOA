page {
  background: #f5f7fa;
}

.page--brand {
  background: #f5f7fa;
  min-height: 100vh;
}

.brand-hero {
  width: 100%;
  height: 384rpx;
  display: block;
  background: #003b70;
}

.brand-body {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.brand-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 16rpx;
}

.brand-intro {
  display: block;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
  margin-bottom: 32rpx;
}

.brand-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.brand-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.brand-card__text {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.65;
}

.brand-values {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.brand-value {
  width: 50%;
  padding-right: 16rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.brand-value__title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 8rpx;
}

.brand-value__desc {
  display: block;
  font-size: 20rpx;
  color: #6b7280;
  line-height: 1.45;
}

.brand-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.brand-tag {
  font-size: 20rpx;
  font-weight: 500;
  color: #374151;
  background: #f3f4f6;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
