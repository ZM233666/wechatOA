page {
  background: #f5f7fa;
}

.page--profile {
  background: #f5f7fa;
  min-height: 100vh;
}

.profile {
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
  margin-bottom: 20rpx;
}

.profile-hero__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 2rpx solid #e5e7eb;
  background: #003b70;
  margin-bottom: 24rpx;
}

.profile-hero__name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.profile-hero__title {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.4;
}

.profile-hero__dept {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.profile-hero__arrow {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #d1d5db;
  line-height: 1;
}

.profile-info {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.profile-info__head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.profile-info__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #003b70;
}

.profile-info__subtitle {
  font-size: 22rpx;
  color: #9ca3af;
}

.profile-info__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f9fafb;
}

.profile-info__icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.profile-info__label {
  width: 196rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.profile-info__label-cn {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  line-height: 1.3;
}

.profile-info__label-en {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.3;
}

.profile-info__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.4;
  word-break: break-word;
}
