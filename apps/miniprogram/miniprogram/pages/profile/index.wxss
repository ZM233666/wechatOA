page {
  background: #f5f7fa;
}

.page--profile {
  background: #f5f7fa;
  min-height: 100vh;
}

.profile,
.basic-info,
.identity-binding {
  padding: 24rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
  margin-bottom: 20rpx;
}

.profile-hero__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 2rpx solid #e5e7eb;
  background: #003b70;
  margin-bottom: 24rpx;
}

.profile-hero__name {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.profile-hero__title {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.4;
}

.profile-hero__dept {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.setting-menu {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.setting-menu__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  border-top: 1rpx solid #f9fafb;
}

.setting-menu__item:first-child {
  border-top: none;
}

.setting-menu__text {
  flex: 1;
  min-width: 0;
}

.setting-menu__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #003b70;
  line-height: 1.35;
}

.setting-menu__subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.35;
}

.setting-menu__arrow {
  font-size: 36rpx;
  color: #d1d5db;
  line-height: 1;
  margin-left: 16rpx;
}

.basic-info__card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.basic-info__head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.basic-info__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #003b70;
}

.basic-info__subtitle {
  font-size: 22rpx;
  color: #9ca3af;
}

.basic-info__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f9fafb;
}

.basic-info__icon {
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.basic-info__label {
  width: 196rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.basic-info__label-cn {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #374151;
  line-height: 1.3;
}

.basic-info__label-en {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.3;
}

.basic-info__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.4;
  word-break: break-word;
}

.identity-binding__card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.identity-binding__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 1.35;
}

.identity-binding__desc {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.55;
}

.identity-binding__hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.identity-binding__btn {
  margin-top: 40rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #003b70;
  border-radius: 16rpx;
}

.identity-binding__btn--disabled {
  color: #9ca3af;
  background: #e5e7eb;
  pointer-events: none;
}

.bind-panel {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.bind-panel__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 1.35;
}

.bind-panel__subtitle {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.45;
}

.bind-panel__input {
  height: 88rpx;
  padding: 0 24rpx;
  background: #f9fafb;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #111827;
}

.bind-panel__input--error {
  border-color: #ef4444;
  background: #fef2f2;
}

.bind-panel__placeholder {
  color: #9ca3af;
  font-size: 28rpx;
}

.bind-panel__error {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ef4444;
  line-height: 1.4;
}

.bind-panel__actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 28rpx;
}

.bind-panel__btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.bind-panel__btn--ghost {
  color: #374151;
  background: #f3f4f6;
}

.bind-panel__btn--primary {
  color: #ffffff;
  background: #003b70;
}

.bind-panel__btn--disabled {
  opacity: 0.65;
  pointer-events: none;
}

.identity-bound__card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.identity-bound__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.identity-bound__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 1.35;
}

.identity-bound__badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #047857;
  background: #ecfdf5;
  border-radius: 999rpx;
}

.identity-bound__hint {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.identity-bound__row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #f3f4f6;
}

.identity-bound__row--last {
  padding-bottom: 0;
}

.identity-bound__label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
}

.identity-bound__value {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: 26rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.4;
  word-break: break-word;
}
