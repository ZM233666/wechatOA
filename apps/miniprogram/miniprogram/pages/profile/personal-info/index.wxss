page {
  background: #f5f7fa;
}

.page--personal-info {
  background: #f5f7fa;
  min-height: 100vh;
}

.personal-info {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.personal-info__hero {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.personal-info__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 80rpx;
  border: 4rpx solid #f3f4f6;
  background: #003b70;
  margin-bottom: 24rpx;
}

.personal-info__name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
}

.personal-info__meta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.4;
}

.personal-info__role {
  display: inline-block;
  margin-top: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  font-size: 22rpx;
  font-weight: 700;
  color: #003b70;
}

.personal-info__section-title {
  display: block;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #003b70;
}

.personal-info__roles {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.personal-info__role-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.personal-info__role-item:last-child {
  border-bottom: none;
}

.personal-info__role-item--active {
  background: rgba(239, 246, 255, 0.7);
  border-radius: 16rpx;
}

.personal-info__role-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1f2937;
}

.personal-info__role-check {
  font-size: 32rpx;
  font-weight: 700;
  color: #003b70;
  line-height: 1;
}
