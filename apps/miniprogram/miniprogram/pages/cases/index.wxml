<view class="page page--cases">
  <nav-brand title="Project Cases" show-back="{{true}}"></nav-brand>

  <view class="cases">
    <text class="cases__heading">Project Cases</text>
    <content-skeleton wx:if="{{pageStatus === 'loading'}}" variant="list"></content-skeleton>
    <view wx:elif="{{pageStatus === 'empty'}}" bindtap="onRetry">
      <empty-state title="{{emptyTitle || '更多内容，即将与你分享'}}" description="{{emptyDesc}}"></empty-state>
    </view>
    <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无项目案例"></empty-state>

    <view wx:if="{{listRefreshing}}" class="cases__hint">正在更新</view>
    <view
      class="case-card tap-feedback"
      wx:for="{{cases}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtouchstart="onCaseTouchStart"
      bindtap="onCaseTap"
    >
      <image class="case-card__image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" data-id="{{item.id}}" binderror="onCaseImageError"></image>
      <view class="case-card__body">
        <text class="case-card__title">{{item.title}}</text>
        <text class="case-card__desc">{{item.desc}}</text>
      </view>
    </view>
  </view>
  <app-tab-bar></app-tab-bar>
</view>
