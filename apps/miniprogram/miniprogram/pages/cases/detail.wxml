<view class="page page--case-detail">
  <nav-brand title="Case Details" show-back="{{true}}"></nav-brand>

  <view wx:if="{{pageStatus === 'success' && item}}" class="case-detail">
    <image class="case-detail__cover" src="{{item.image}}" mode="aspectFill" binderror="onCoverImageError"></image>
    <view class="case-detail__body">
      <text class="case-detail__title">{{item.title}}</text>
      <text wx:if="{{item.meta}}" class="case-detail__meta">{{item.meta}}</text>
      <article-body
        blocks="{{item.richContent}}"
        html="{{item.contentHtml}}"
        body-format="{{item.bodyFormat}}"
      ></article-body>
    </view>
  </view>

  <content-skeleton wx:elif="{{pageStatus === 'loading'}}" variant="detail"></content-skeleton>
  <view wx:elif="{{pageStatus === 'empty'}}" bindtap="onRetry">
    <empty-state title="{{emptyTitle || '更多内容，即将与你分享'}}" description="{{emptyDesc}}"></empty-state>
  </view>
  <view wx:else class="case-empty">
    <empty-state title="未找到该项目案例"></empty-state>
  </view>
  <app-tab-bar></app-tab-bar>
</view>
