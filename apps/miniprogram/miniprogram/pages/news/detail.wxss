page {
  background: #ffffff;
}

.page--news-detail {
  background: #ffffff;
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.news-detail__cover {
  width: 100%;
  height: 448rpx;
  display: block;
  background: #f3f4f6;
}

.news-detail__body {
  padding: 40rpx 40rpx 24rpx;
}

.news-detail__badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 500;
  color: #003b70;
  background: #eff6ff;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.news-detail__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.news-detail__subtitle {
  display: block;
  font-size: 28rpx;
  color: #4b5563;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.news-detail__meta {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 40rpx;
}

.news-detail__share {
  width: 72rpx !important;
  min-width: 72rpx !important;
  max-width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}

.news-detail__share::after {
  border: none;
}

.news-detail__content {
  display: block;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.news-empty {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9ca3af;
}

.news-detail__bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding: 4rpx;
  background: #ffffff;
  border: 1rpx solid #f3f4f6;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(3, 62, 112, 0.12);
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  z-index: 20;
}

.news-detail__action {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.news-detail__icon {
  width: 48rpx;
  height: 48rpx;
}

.news-detail__star {
  font-size: 44rpx;
  line-height: 1;
  color: #9ca3af;
}

.news-detail__star--on {
  color: #d4a84b;
}
