<wxs src="../../utils/media-url.wxs" module="media" />
<view class="page page--news-detail">
  <nav-brand title="News Details" show-back="{{true}}"></nav-brand>

  <view wx:if="{{pageStatus === 'success' && news}}" class="news-detail">
    <image class="news-detail__cover" src="{{media.imageSrc(news.image, apiBaseUrl)}}" mode="aspectFill" binderror="onCoverImageError"></image>
    <view class="news-detail__body">
      <text class="news-detail__badge">{{news.category}}</text>
      <text class="news-detail__title">{{news.title}}</text>
      <text wx:if="{{news.subtitle}}" class="news-detail__subtitle">{{news.subtitle}}</text>
      <text class="news-detail__meta">{{news.source || news.author}} · {{news.date}}</text>
      <article-body
        blocks="{{news.richContent}}"
        html="{{news.contentHtml}}"
        body-format="{{news.bodyFormat}}"
      ></article-body>
    </view>
  </view>

  <content-skeleton wx:elif="{{pageStatus === 'loading'}}" variant="detail"></content-skeleton>
  <view wx:elif="{{pageStatus === 'empty'}}" bindtap="onRetry">
    <empty-state title="{{emptyTitle || '更多内容，即将与你分享'}}" description="{{emptyDesc}}"></empty-state>
  </view>
  <view wx:else class="news-empty">
    <empty-state title="未找到该新闻" description="请返回列表重试"></empty-state>
  </view>

  <view wx:if="{{news}}" class="news-detail__bar">
    <view class="news-detail__action tap-feedback" bindtap="onToggleFavorite">
      <text class="news-detail__star {{favorited ? 'news-detail__star--on' : ''}}">★</text>
    </view>
    <button class="news-detail__action news-detail__share tap-feedback" open-type="share">
      <image class="news-detail__icon" src="/pages/products/assets/images/content/icon-share.png" mode="aspectFit"></image>
    </button>
  </view>
  <app-tab-bar></app-tab-bar>
</view>
