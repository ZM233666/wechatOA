page {
  background: #f5f7fa;
}

.page--event-detail {
  background: #f5f7fa;
  min-height: 100vh;
}

.event-detail {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.event-detail__card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.event-detail__hero {
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.event-detail__hero--annual {
  background: linear-gradient(90deg, #9333ea 0%, #4f46e5 100%);
}

.event-detail__hero--outings {
  background: #16a34a;
}

.event-detail__hero--health {
  background: #ef4444;
}

.event-detail__hero-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}

.event-detail__hero-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.4;
}

.event-detail__hero-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.45;
}

.event-detail__body {
  padding: 28rpx;
}

.event-detail__info {
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.event-detail__info--annual {
  background: #faf5ff;
}

.event-detail__info--health {
  background: #fef2f2;
}

.event-detail__info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.event-detail__info--annual .event-detail__info-title {
  color: #581c87;
}

.event-detail__info--health .event-detail__info-title {
  color: #991b1b;
}

.event-detail__info-line,
.event-detail__info-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.event-detail__info--annual .event-detail__info-line {
  color: #6b21a8;
}

.event-detail__info--health .event-detail__info-desc {
  color: #991b1b;
}

.event-detail__info-desc--en {
  margin-top: 8rpx;
}

.event-detail__section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 16rpx;
}

.event-detail__list-item {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.65;
  margin-bottom: 10rpx;
}

.outing-card {
  border: 1rpx solid #f3f4f6;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(3, 62, 112, 0.03);
}

.outing-card:last-child {
  margin-bottom: 0;
}

.outing-card__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.outing-card__title {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
}

.outing-card__badge {
  font-size: 20rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.outing-card__badge--open {
  color: #15803d;
  background: #dcfce7;
}

.outing-card__badge--closed {
  color: #6b7280;
  background: #f3f4f6;
}

.outing-card__desc {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.55;
}

.outing-card__desc--en {
  margin-top: 8rpx;
}

.outing-card__time {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.benefit-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.benefit-item:last-child {
  margin-bottom: 0;
}

.benefit-item__emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.benefit-item__meta {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.benefit-item__title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.35;
}

.benefit-item__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.45;
}

.benefit-item__desc--en {
  margin-top: 4rpx;
}
