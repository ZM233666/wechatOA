<view class="page page--event-detail">
  <nav-brand title="Health" show-back="{{true}}"></nav-brand>

  <view wx:if="{{pageStatus === 'loading'}}" class="event-detail__state">加载中…</view>
  <view wx:elif="{{pageStatus === 'error'}}" class="event-detail__state event-detail__state--error">{{errorText}}</view>
  <view wx:elif="{{pageStatus === 'empty'}}" class="event-detail__state">暂无已发布的体检安排</view>

  <view class="event-detail" wx:elif="{{pageStatus === 'success'}}">
    <view class="event-detail__card">
      <view class="event-detail__hero event-detail__hero--health">
        <image
          class="event-detail__hero-icon"
          src="/assets/images/kb-life/event-health-white.png"
          mode="aspectFit"
        ></image>
        <text class="event-detail__hero-title">{{event.title}}</text>
        <text class="event-detail__hero-subtitle" wx:if="{{event.subtitle}}">{{event.subtitle}}</text>
      </view>

      <view class="event-detail__body">
        <view class="event-detail__info event-detail__info--health" wx:if="{{event.pdfUrl}}">
          <button class="health-pdf-btn" bindtap="onDownloadPdf" loading="{{downloading}}" disabled="{{downloading}}">
            下载体检手册 PDF
          </button>
          <text class="event-detail__info-desc health-pdf-name" wx:if="{{event.pdfFileName}}">{{event.pdfFileName}}</text>
        </view>

        <view class="health-images" wx:if="{{event.images.length}}">
          <image
            class="health-images__item"
            wx:for="{{event.images}}"
            wx:key="*this"
            src="{{item}}"
            mode="widthFix"
          ></image>
        </view>
      </view>
    </view>
  </view>
</view>
