page {
  background: #f5f7fa;
}

.page--shuttle {
  background: #f5f7fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.shuttle-head {
  background: #ffffff;
  padding: 24rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
  box-shadow: 0 4rpx 12rpx rgba(3, 62, 112, 0.04);
}

.shuttle-head__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 20rpx;
}

.shuttle-search {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx 0 72rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.shuttle-search__icon {
  position: absolute;
  left: 24rpx;
  width: 36rpx;
  height: 36rpx;
}

.shuttle-search__input {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  color: #111827;
}

.shuttle-search__placeholder {
  color: #9ca3af;
  font-size: 24rpx;
}

.shuttle-list {
  flex: 1;
  height: 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.route-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.route-card__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-bottom: 16rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.route-card__id {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: #003b70;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.route-card__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.route-card__body {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.route-card__pin {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.route-card__stations {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.65;
}

.shuttle-empty {
  padding: 80rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.shuttle-empty__icon {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.shuttle-empty__icon image {
  width: 48rpx;
  height: 48rpx;
}

.shuttle-empty__text {
  font-size: 26rpx;
  color: #6b7280;
}

.shuttle-notice {
  margin-top: 8rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #eff6ff;
  border-radius: 16rpx;
}

.shuttle-notice__text {
  font-size: 22rpx;
  color: #1e40af;
  line-height: 1.55;
}
