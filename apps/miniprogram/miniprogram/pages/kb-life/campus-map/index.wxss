page {
  background: #000000;
}

.page--campus-map {
  min-height: 100vh;
  background: #000000;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.campus-map__header {
  background: rgba(0, 0, 0, 0.88);
  border-bottom: 1rpx solid #1f2937;
  flex-shrink: 0;
  z-index: 10;
}

.campus-map__bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.campus-map__back {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -8rpx;
}

.campus-map__back-icon {
  color: #d1d5db;
  font-size: 48rpx;
  line-height: 1;
  font-weight: 300;
}

.campus-map__title {
  flex: 1;
  text-align: center;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  margin-right: 48rpx;
}

.campus-map__bar-spacer {
  width: 16rpx;
}

.campus-map__body {
  flex: 1;
  min-height: 0;
  position: relative;
  background: #111111;
}

.campus-map__stage {
  position: absolute;
  inset: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.campus-map__area {
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.campus-map__view {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.campus-map__image {
  width: 100%;
  display: block;
  border-radius: 8rpx;
}

.campus-map__toolbar {
  flex-shrink: 0;
  background: rgba(0, 0, 0, 0.88);
  border-top: 1rpx solid #1f2937;
  padding: 24rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
}

.campus-map__tool {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #1f2937;
  display: flex;
  align-items: center;
  justify-content: center;
}

.campus-map__tool-icon {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1;
}

.campus-map__tool-img {
  width: 40rpx;
  height: 40rpx;
}
