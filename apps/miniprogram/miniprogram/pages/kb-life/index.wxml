<view class="page page--life {{readerVisible ? 'page--life-reading' : ''}}">
  <nav-brand
    wx:if="{{!readerVisible}}"
    title="{{navTitle}}"
    show-back="{{deniedVisible}}"
    back-as-event="{{deniedVisible}}"
    bind:back="onListBack"
  ></nav-brand>

  <insight-reader
    wx:if="{{readerVisible}}"
    visible="{{true}}"
    report-id="{{readerIssueId}}"
    source="{{readerSource}}"
    has-nav-bar="{{false}}"
    bind:close="onReaderClose"
  ></insight-reader>

  <view wx:if="{{!readerVisible && deniedVisible}}" class="wetalk-denied">
    <view class="wetalk-denied__icon">
      <text class="wetalk-denied__icon-text">!</text>
    </view>
    <block wx:if="{{identityBound}}">
      <text class="wetalk-denied__title">无访问权限</text>
      <text class="wetalk-denied__desc">您没有访问此内容的权限。</text>
      <text class="wetalk-denied__desc-en">You do not have permission to view this content.</text>
    </block>
    <block wx:elif="{{deniedKind === 'campus'}}">
      <text class="wetalk-denied__title">Identity Binding Required</text>
      <text class="wetalk-denied__desc">园区地图、班车、食堂菜单与假期日历需完成身份绑定后访问。</text>
      <text class="wetalk-denied__desc-en">Campus map, shuttle bus, cafeteria menu, and holiday calendar require identity binding.</text>
    </block>
    <block wx:else>
      <text class="wetalk-denied__title">Internal Only</text>
      <text class="wetalk-denied__desc">此功能仅面向KB员工开放。</text>
      <text class="wetalk-denied__desc-en">This feature is only open to KB employees.</text>
    </block>
    <view wx:if="{{!identityBound}}" class="wetalk-denied__btn tap-feedback" bindtap="onGoIdentityBinding">
      <text class="wetalk-denied__btn-text">前往身份绑定</text>
    </view>
  </view>

  <view wx:if="{{!readerVisible && !deniedVisible}}" class="life">
    <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载 KB Life"></empty-state>
    <empty-state wx:elif="{{pageStatus === 'empty'}}" title="{{emptyTitle || '更多内容，即将与你分享'}}" description="{{emptyDesc}}"></empty-state>
    <block wx:if="{{pageStatus === 'success'}}">
    <view wx:if="{{banners.length > 0}}" class="life-banner">
      <swiper
        class="life-banner__swiper"
        indicator-dots="{{true}}"
        indicator-color="rgba(255, 255, 255, 0.45)"
        indicator-active-color="#003B70"
        autoplay="{{true}}"
        interval="{{4200}}"
        duration="{{500}}"
        circular="{{true}}"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="life-banner__item tap-feedback" data-id="{{item.id}}" bindtap="onLifeBannerTap">
            <image class="life-banner__image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="life-banner__mask"></view>
            <view class="life-banner__content">
              <text class="life-banner__title">{{item.title}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>
    <view wx:else class="life-banner" bindtap="onCarePlaceholderTap">
      <image
        class="life-banner__image life-banner__image--placeholder"
        src="/assets/images/kb-life/activities-in-china.png"
        mode="aspectFill"
      ></image>
    </view>

    <view class="life-body">
      <view class="life-row">
        <view class="wetalk tap-feedback" bindtap="onWetalkTap">
          <text class="wetalk__label">WeTalk News</text>
          <view class="wetalk__cover">
            <image
              class="wetalk__cover-image"
              src="{{wetalkFeatured ? wetalkFeatured.image : wetalkMagazineCover}}"
              mode="aspectFill"
            ></image>
            <text wx:if="{{wetalkFeatured}}" class="wetalk__badge">WeTalk</text>
            <text wx:if="{{wetalkFeatured}}" class="wetalk__cover-title">{{wetalkFeatured.title}}</text>
          </view>
          <view class="wetalk__btn">
            <text class="wetalk__btn-text">Read Now</text>
          </view>
        </view>

        <view class="campus">
          <view class="campus__head">
            <view class="campus__titles">
              <text class="campus__title">选择地点</text>
              <text class="campus__subtitle">Location</text>
            </view>
            <picker
              mode="selector"
              range="{{locations}}"
              value="{{locationIndex}}"
              bindchange="onLocationChange"
            >
              <view class="campus__picker">
                <text class="campus__picker-text">{{selectedLocation}}</text>
                <text class="campus__picker-arrow">▾</text>
              </view>
            </picker>
          </view>

          <view class="campus__grid">
            <block wx:for="{{campusServices}}" wx:key="id">
              <view
                wx:if="{{item.openable}}"
                class="campus__item tap-feedback"
                data-id="{{item.id}}"
                bindtap="onCampusTap"
              >
                <view class="campus__icon-wrap">
                  <image class="campus__icon" src="{{item.icon}}" mode="aspectFit"></image>
                </view>
                <text class="campus__item-title">{{item.title}}</text>
                <text class="campus__item-sub">{{item.subtitle}}</text>
              </view>
              <view wx:else class="campus__item campus__item--disabled">
                <view class="campus__icon-wrap">
                  <image class="campus__icon" src="{{item.icon}}" mode="aspectFit"></image>
                </view>
                <text class="campus__item-title">{{item.title}}</text>
                <text class="campus__item-sub">{{item.subtitle}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>

      <view class="employee">
        <view class="employee__head">
          <text class="employee__title">员工服务</text>
          <text class="employee__subtitle">Employee Services</text>
        </view>
        <view class="employee__grid">
          <block wx:for="{{employeeServices}}" wx:key="id">
            <view
              wx:if="{{item.path}}"
              class="employee__item tap-feedback"
              data-id="{{item.id}}"
              bindtap="onEmployeeTap"
            >
              <view class="employee__icon-wrap">
                <image class="employee__icon" src="{{item.icon}}" mode="aspectFit"></image>
              </view>
              <text class="employee__item-title">{{item.title}}</text>
              <text class="employee__item-sub">{{item.subtitle}}</text>
            </view>
            <view wx:else class="employee__item">
              <view class="employee__icon-wrap">
                <image class="employee__icon" src="{{item.icon}}" mode="aspectFit"></image>
              </view>
              <text class="employee__item-title">{{item.title}}</text>
              <text class="employee__item-sub">{{item.subtitle}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
    </block>
  </view>
</view>
