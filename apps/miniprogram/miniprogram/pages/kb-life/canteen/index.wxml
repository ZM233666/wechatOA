<view class="page page--canteen">
  <nav-brand title="Canteen Menu · {{location}}" show-back="{{true}}"></nav-brand>

  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载食堂菜单"></empty-state>
  <empty-state
    wx:elif="{{pageStatus === 'error'}}"
    title="加载失败"
    description="{{errorText}}"
  ></empty-state>

  <block wx:elif="{{pageStatus === 'success'}}">
    <view class="canteen-hero">
      <image
        class="canteen-hero__image"
        src="{{coverImage || '/assets/images/kb-life/canteen-hero.png'}}"
        mode="aspectFill"
      ></image>
      <view class="canteen-hero__mask"></view>
      <view class="canteen-hero__content">
        <text class="canteen-hero__title">{{menuTitle || 'Knorr-Bremse Canteen'}}</text>
        <text class="canteen-hero__subtitle">{{menuDate || 'Powered by Sodexo'}}</text>
      </view>
    </view>

    <view class="canteen-body">
      <view class="canteen-card">
        <view class="canteen-card__head">
          <image class="canteen-card__info" src="/assets/images/kb-life/info.png" mode="aspectFit"></image>
          <text class="canteen-card__title canteen-card__title--navy">食堂介绍 (Introduction)</text>
        </view>
        <text class="canteen-card__intro">{{intro}}</text>
      </view>

      <view class="canteen-card">
        <view class="canteen-card__menu-head">
          <text class="canteen-card__title">今日美食 (Today's Menu)</text>
          <text class="canteen-card__badge">午餐 Lunch</text>
        </view>

        <block wx:if="{{live}}">
          <view wx:if="{{sections.length === 0}}" class="menu-empty">今日暂无已发布菜单</view>
          <view class="menu-section" wx:for="{{sections}}" wx:key="id">
            <text class="menu-section__title">{{item.title}}</text>
            <text wx:if="{{item.text}}" class="menu-section__text">{{item.text}}</text>
            <image
              wx:for="{{item.images}}"
              wx:for-item="imageUrl"
              wx:for-index="imageIndex"
              wx:key="imageIndex"
              class="menu-section__image"
              src="{{imageUrl}}"
              mode="widthFix"
            ></image>
          </view>
        </block>

        <block wx:else>
          <view class="menu-item" wx:for="{{menuItems}}" wx:key="id">
            <image class="menu-item__image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="menu-item__meta">
              <text class="menu-item__title">{{item.title}}</text>
              <text class="menu-item__desc">{{item.description}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
