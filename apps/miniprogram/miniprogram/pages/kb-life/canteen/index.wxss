page {
  background: #f5f7fa;
}

.page--canteen {
  background: #f5f7fa;
  min-height: 100vh;
}

.canteen-hero {
  position: relative;
  height: 384rpx;
  background: #111827;
}

.canteen-hero__image {
  width: 100%;
  height: 100%;
  display: block;
}

.canteen-hero__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 20%, rgba(0, 0, 0, 0.78) 100%);
}

.canteen-hero__content {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
  z-index: 1;
}

.canteen-hero__title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.3;
}

.canteen-hero__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
}

.canteen-body {
  position: relative;
  z-index: 2;
  margin-top: -32rpx;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.canteen-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.canteen-card__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.canteen-card__info {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.canteen-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.canteen-card__title--navy {
  color: #003b70;
}

.canteen-card__intro {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.canteen-card__menu-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.canteen-card__badge {
  font-size: 22rpx;
  font-weight: 500;
  color: #f97316;
  background: #fff7ed;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 28rpx;
}

.menu-item:last-child {
  margin-bottom: 0;
}

.menu-item__image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.menu-item__meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.menu-item__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.35;
}

.menu-item__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.45;
}
