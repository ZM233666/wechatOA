page {
  background: #f5f7fa;
}

.job-empty {
  padding: 80rpx 32rpx;
}

.job-empty__text {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
}

.page--job-detail {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.job-detail__hero {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.job-detail__title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.job-detail__tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.job-detail__tag {
  font-size: 22rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.job-detail__section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.job-detail__section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.job-detail__bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: #e4a870;
  margin-right: 12rpx;
}

.job-detail__section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #003b70;
}

.job-detail__body {
  display: block;
  font-size: 26rpx;
  color: #374151;
  line-height: 1.7;
  white-space: pre-line;
}

.job-detail__apply {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f3f4f6;
  box-shadow: 0 -8rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 20;
}

.job-detail__btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #003b70;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 20rpx;
}

.job-detail__btn::after {
  border: none;
}
