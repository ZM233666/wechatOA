page {
  background: #f5f7fa;
}

.page--jobs {
  background: #f5f7fa;
  min-height: 100vh;
}

.jobs {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.jobs__heading {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #003b70;
  margin-bottom: 24rpx;
}

.job-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.job-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.job-card__tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.job-card__tag {
  font-size: 20rpx;
  color: #6b7280;
  background: #f9fafb;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.job-card__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f3f4f6;
}

.job-card__more {
  font-size: 22rpx;
  font-weight: 500;
  color: #003b70;
}

.job-card__arrow {
  font-size: 36rpx;
  color: #9ca3af;
  line-height: 1;
}
