page {
  background: #f5f7fa;
}

.page--handbook {
  background: #f5f7fa;
  min-height: 100vh;
}

.handbook {
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.handbook-hero {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
  margin-bottom: 24rpx;
}

.handbook-hero__banner {
  background: #003b70;
  padding: 56rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.handbook-hero__icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.handbook-hero__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  line-height: 1.4;
}

.handbook-hero__edition {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  text-align: center;
}

.handbook-hero__body {
  padding: 32rpx 28rpx 28rpx;
}

.handbook-hero__intro {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.handbook-hero__intro--en {
  margin-top: 16rpx;
}

.handbook-hero__btn {
  margin-top: 32rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #003b70;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.handbook-hero__download {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.handbook-hero__btn-text {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.handbook-nav {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 0 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.handbook-nav__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  padding: 28rpx 28rpx 24rpx;
}

.handbook-nav__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-top: 1rpx solid #f3f4f6;
}

.handbook-nav__item-title {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.45;
}

.handbook-nav__link {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
