page {
  background: #ffffff;
}

.page--home {
  background: #ffffff;
}

.home {
  padding-bottom: 8rpx;
}

.home-banner {
  width: 100%;
  background: #e5e7eb;
}

.home-banner__swiper {
  height: 340rpx;
}

.home-banner__item {
  position: relative;
  width: 100%;
  height: 340rpx;
}

.home-banner__image {
  width: 100%;
  height: 100%;
  display: block;
}

.home-banner__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    rgba(0, 59, 112, 0.9) 0%,
    rgba(0, 59, 112, 0.35) 48%,
    rgba(0, 59, 112, 0) 100%
  );
}

.home-banner__content {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 40rpx;
  z-index: 1;
}

.home-banner__title {
  display: block;
  width: 80%;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.35;
}

.home-banner__desc {
  display: block;
  margin-top: 10rpx;
  width: 78%;
  font-size: 22rpx;
  color: rgba(229, 231, 235, 0.95);
  line-height: 1.4;
}

.home-entries {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  padding: 40rpx 32rpx 36rpx;
  border-bottom: 1rpx solid #f3f4f6;
  background: #ffffff;
}

.home-entry {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.home-entry__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #fff7ed;
  border: 1rpx solid rgba(255, 237, 213, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(194, 155, 98, 0.08);
}

.home-entry__icon {
  width: 52rpx;
  height: 52rpx;
}

.home-entry__title {
  font-size: 24rpx;
  font-weight: 500;
  color: #1f2937;
  line-height: 1.3;
  text-align: center;
}

.home-entry__subtitle {
  margin-top: 4rpx;
  width: 140rpx;
  font-size: 20rpx;
  color: #9ca3af;
  line-height: 1.25;
  text-align: center;
}

.home-news {
  padding: 32rpx 32rpx 8rpx;
  background: #ffffff;
}

.home-news__list {
  padding: 0;
}

.home-news__item {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  padding: 0;
  margin-bottom: 32rpx;
}

.home-news__item:last-child {
  margin-bottom: 0;
}

.home-news__thumb {
  width: 192rpx;
  height: 128rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.home-news__meta {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.home-news__title {
  font-size: 26rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.4;
}

.home-news__date {
  font-size: 20rpx;
  color: #9ca3af;
}
