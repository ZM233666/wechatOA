<view class="page page--care-detail">
  <nav-brand title="Employee Care" show-back="{{true}}"></nav-brand>

  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载文章"></empty-state>
  <view wx:elif="{{pageStatus === 'error'}}" bindtap="onRetry">
    <empty-state title="加载失败" description="{{errorText}}"></empty-state>
  </view>
  <empty-state wx:elif="{{pageStatus === 'empty'}}" title="未找到该文章"></empty-state>

  <view wx:elif="{{article}}" class="care-detail">
    <image
      wx:if="{{article.image}}"
      class="care-detail__cover"
      src="{{article.image}}"
      mode="widthFix"
    ></image>
    <view class="care-detail__body">
      <text class="care-detail__badge">{{article.category}}</text>
      <text class="care-detail__title">{{article.title}}</text>
      <text class="care-detail__meta">{{article.dateLabel}}</text>
      <article-renderer
        wx:if="{{useBlockBody}}"
        class="care-detail__html"
        blocks="{{article.richContent}}"
        carousel-preview="{{false}}"
      ></article-renderer>
      <html-content
        wx:elif="{{article.contentHtml}}"
        class="care-detail__html"
        html="{{article.contentHtml}}"
      ></html-content>
      <article-renderer
        wx:else
        class="care-detail__html"
        blocks="{{article.richContent}}"
        carousel-preview="{{false}}"
      ></article-renderer>
    </view>
  </view>

  <app-tab-bar></app-tab-bar>
</view>
