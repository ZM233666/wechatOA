<view class="page page--care">
  <nav-brand title="Employee Care" show-back="{{true}}"></nav-brand>

  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载员工关怀"></empty-state>
  <view wx:elif="{{pageStatus === 'error'}}" bindtap="loadCare">
    <empty-state title="加载失败" description="{{errorText}}"></empty-state>
  </view>
  <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无关怀活动"></empty-state>

  <block wx:elif="{{pageStatus === 'success'}}">
    <view class="care-body care-body--list">
      <view class="care-section">
        <view class="care-section__head">
          <view class="care-section__bar"></view>
          <text class="care-section__title">Latest Initiatives</text>
        </view>

        <view
          class="care-card tap-feedback"
          wx:for="{{initiatives}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onReadMore"
        >
          <view wx:if="{{item.image}}" class="care-card__cover">
            <image class="care-card__image" src="{{item.image}}" mode="aspectFill"></image>
            <text class="care-card__badge">{{item.category}}</text>
          </view>
          <view class="care-card__body">
            <text wx:if="{{!item.image}}" class="care-card__badge care-card__badge--inline">{{item.category}}</text>
            <text class="care-card__title">{{item.title}}</text>
            <text class="care-card__desc text-ellipsis-2">{{item.description}}</text>
            <view class="care-card__foot">
              <view class="care-card__date">
                <image
                  class="care-card__clock"
                  src="/assets/images/kb-life/clock-gray.png"
                  mode="aspectFit"
                ></image>
                <text>{{item.date}}</text>
              </view>
              <text class="care-card__more">Read More ></text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
  <app-tab-bar></app-tab-bar>
</view>
