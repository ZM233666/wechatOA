page {
  background: #f5f7fa;
}

.page--care {
  background: #f5f7fa;
  min-height: 100vh;
}

.care-hero {
  position: relative;
  height: 560rpx;
  background: #111827;
}

.care-hero__image {
  width: 100%;
  height: 100%;
  display: block;
}

.care-hero__mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.28) 0%,
    rgba(0, 0, 0, 0.35) 45%,
    rgba(0, 0, 0, 0.8) 100%
  );
}

.care-hero__content {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 40rpx;
  z-index: 1;
}

.care-hero__title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.35;
  margin-bottom: 12rpx;
}

.care-hero__subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.55;
}

.care-body {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.care-section__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 24rpx;
}

.care-section__bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: #003b70;
  margin-right: 12rpx;
}

.care-section__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.care-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
}

.care-card__cover {
  position: relative;
  height: 320rpx;
}

.care-card__image {
  width: 100%;
  height: 100%;
  display: block;
}

.care-card__badge {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: #003b70;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
}

.care-card__body {
  padding: 28rpx;
}

.care-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.care-card__desc {
  display: block;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.55;
  margin-bottom: 20rpx;
}

.care-card__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.care-card__date {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 22rpx;
  color: #9ca3af;
}

.care-card__clock {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

.care-card__more {
  font-size: 22rpx;
  font-weight: 500;
  color: #003b70;
}
