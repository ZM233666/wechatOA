@import '../../detail-common.wxss';

.album-detail__hero .event-detail__hero-title {
  font-size: 44rpx;
  line-height: 1.35;
}

.album-detail__cover {
  display: block;
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.album-detail__content {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #374151;
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.album-detail__published {
  display: block;
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 28rpx;
}

.album-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.album-grid__item {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  display: block;
}
