@import '../../detail-common.wxss';

.album-detail__date {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.album-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.album-grid__item {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  display: block;
}
