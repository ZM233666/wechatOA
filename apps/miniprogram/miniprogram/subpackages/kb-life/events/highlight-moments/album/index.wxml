<wxs src="../../../../../utils/media-url.wxs" module="media" />
<view class="page page--event-detail">
  <nav-brand title="Album" show-back="{{true}}"></nav-brand>

  <view wx:if="{{pageStatus === 'loading'}}" class="event-detail__state">加载中…</view>
  <empty-state wx:elif="{{pageStatus === 'empty'}}" title="{{emptyTitle || '暂无内容'}}" description="{{emptyDesc}}"></empty-state>
  <view class="event-detail" wx:elif="{{pageStatus === 'success'}}">
    <view class="event-detail__card">
      <view class="event-detail__hero event-detail__hero--highlights album-detail__hero">
        <image
          class="event-detail__hero-icon"
          src="/subpackages/kb-life/assets/images/event-highlights.png"
          mode="aspectFit"
        ></image>
        <text class="event-detail__hero-title">{{album.title}}</text>
        <text class="event-detail__hero-subtitle" wx:if="{{album.subtitle}}">{{album.subtitle}}</text>
      </view>

      <view class="event-detail__body album-detail">
        <image
          wx:if="{{album.coverImage}}"
          class="album-detail__cover"
          src="{{media.imageSrc(album.coverImage)}}"
          mode="widthFix"
        ></image>
        <text class="album-detail__content" wx:if="{{album.content}}">{{album.content}}</text>
        <text class="album-detail__published" wx:if="{{album.dateLabel}}">发布日期 {{album.dateLabel}}</text>

        <view class="album-grid" wx:if="{{album.images.length}}">
          <image
            class="album-grid__item tap-feedback"
            wx:for="{{album.images}}"
            wx:key="url"
            src="{{media.imageSrc(item.url)}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            show-menu-by-longpress="{{item.allowDownload}}"
            data-url="{{item.url}}"
            bindtap="onPreviewImage"
          ></image>
        </view>
        <view wx:else class="event-detail__state">该相册暂无图片</view>
      </view>
    </view>
  </view>
  <app-tab-bar></app-tab-bar>
</view>
