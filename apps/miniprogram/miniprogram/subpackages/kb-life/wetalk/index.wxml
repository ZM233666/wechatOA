<view class="page page--wetalk {{readerVisible ? 'page--wetalk-reading' : ''}}">
  <insight-reader wx:if="{{readerVisible}}" visible="{{true}}" source="wetalk"
    report-id="{{readerIssueId}}" has-nav-bar="{{false}}" bind:close="onReaderClose"></insight-reader>
  <block wx:if="{{!readerVisible}}">
  <nav-brand title="WeTalk News" show-back="{{true}}"></nav-brand>

  <view class="wetalk-hub">
    <view class="wetalk-news">
      <view class="wetalk-section-head">
        <view class="wetalk-section-head__left">
          <view class="wetalk-section-head__bar"></view>
          <text class="wetalk-section-head__title">Latest News</text>
        </view>
        <picker mode="selector" range="{{yearOptions}}" value="{{yearIndex}}" bindchange="onYearChange">
          <view class="wetalk-year tap-feedback">
            <text class="wetalk-year__text">{{selectedYear === 'All' ? 'Period' : selectedYear}}</text>
            <text class="wetalk-year__arrow">▾</text>
          </view>
        </picker>
      </view>

      <scroll-view class="wetalk-news__scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载 WeTalk"></empty-state>
        <view wx:elif="{{pageStatus === 'empty'}}" bindtap="onRetry">
          <empty-state title="{{emptyTitle || '更多内容，即将与你分享'}}" description="{{emptyDesc}}"></empty-state>
        </view>
        <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无新闻" description="当前年份没有可展示的内容"></empty-state>

        <block wx:elif="{{pageStatus === 'success'}}">
            <block wx:for="{{displayItems}}" wx:key="listKey">
            <view
              wx:if="{{item.type === 'emagazine'}}"
              class="book-card tap-feedback"
              data-id="{{item.id}}"
              data-type="{{item.type}}"
              data-kind="{{item.kind}}"
              bindtap="onNewsTap"
            >
              <view class="book-card__spine">
                <text class="book-card__spine-text">WeTalk</text>
                <text class="book-card__spine-text">Magazine</text>
              </view>
              <view class="book-card__cover">
                <image wx:if="{{item.image}}" class="book-card__image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}"></image>
                <view wx:else class="book-card__image book-card__image--empty"></view>
                <view class="book-card__gutter"></view>
              </view>
              <view class="book-card__page">
                <text class="book-card__title">{{item.title}}</text>
                <text wx:if="{{item.volumeNo}}" class="book-card__volume">{{item.volumeNo}}</text>
                <text class="book-card__issue">{{item.issueLabel || item.displayDate}}</text>
              </view>
            </view>
            <view
              wx:else
              class="news-card news-card--news tap-feedback"
              data-id="{{item.id}}"
              data-type="{{item.type}}"
              data-kind="{{item.kind}}"
              bindtap="onNewsTap"
            >
              <view class="news-card__cover">
                <image wx:if="{{item.image}}" class="news-card__image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}"></image>
                <view wx:else class="news-card__image"></view>
              </view>
              <view class="news-card__body">
                <view class="news-card__badge">
                  <view class="news-card__badge-mark"></view>
                  <text class="news-card__badge-text">WeTalk</text>
                </view>
                <text class="news-card__title">{{item.title}}</text>
                <text class="news-card__date">{{item.displayDate}}</text>
              </view>
            </view>
            </block>
        </block>
      </scroll-view>
    </view>
  </view>

  </block>
  <app-tab-bar></app-tab-bar>
</view>
