<view class="page page--wetalk-detail {{readerVisible ? 'page--wetalk-detail-reading' : ''}}">
  <insight-reader wx:if="{{readerVisible}}" visible="{{true}}" source="wetalk"
    report-id="{{readerIssueId}}" has-nav-bar="{{false}}" bind:close="onReaderClose"></insight-reader>
  <block wx:if="{{!readerVisible}}">
  <nav-brand title="WeTalk News" show-back="{{true}}"></nav-brand>

  <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载文章"></empty-state>
  <view wx:elif="{{pageStatus === 'empty'}}" bindtap="onRetry">
    <empty-state title="{{emptyTitle || '暂无内容'}}" description="{{emptyDesc}}"></empty-state>
  </view>
  <empty-state wx:elif="{{pageStatus === 'empty'}}" title="未找到该文章"></empty-state>

  <view wx:elif="{{article}}" class="wetalk-detail">
    <image
      wx:if="{{article.coverUrl}}"
      class="wetalk-detail__cover"
      src="{{article.coverUrl}}"
      mode="widthFix"
    ></image>
    <view class="wetalk-detail__body">
      <text class="wetalk-detail__badge">WeTalk News</text>
      <text class="wetalk-detail__title">{{article.title}}</text>
      <text class="wetalk-detail__meta">{{article.author ? article.author + ' · ' : ''}}{{article.publishTime}}</text>
      <text class="wetalk-detail__html">{{article.summary}}</text>
      <text wx:if="{{!article.pdfUrl}}">暂无 PDF 附件</text>
      <button wx:if="{{article.pdfUrl}}" bindtap="onOpenPdf">翻书阅读</button>
    </view>
  </view>

  </block>
  <app-tab-bar></app-tab-bar>
</view>
