page {
  background: #f5f7fa;
}

.page--wetalk {
  height: 100vh;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow: hidden;
}

.page--wetalk-reading {
  overflow: hidden;
}

.page--wetalk-reading .insight-reader,
.page--wetalk.page--wetalk-reading > .insight-reader {
  flex: 1;
  min-height: 0;
}

/* 不再额外 padding-bottom：app-tab-bar 自带 placeholder 占位 */
.wetalk-hub {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 8rpx 32rpx 0;
  box-sizing: border-box;
}

.wetalk-section-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
  flex-shrink: 0;
}

.wetalk-section-head__left {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-width: 0;
}

.wetalk-section-head__bar {
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #00467f;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.wetalk-section-head__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.2;
}

.wetalk-year {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(3, 62, 112, 0.06);
  flex-shrink: 0;
}

.wetalk-year__text {
  font-size: 24rpx;
  color: #00467f;
  font-weight: 600;
}

.wetalk-year__arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #6b7280;
}

.wetalk-news {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.wetalk-news__scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  background: #eef2f7;
  border-radius: 24rpx;
  padding: 16rpx 16rpx 8rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(3, 62, 112, 0.06);
}

.news-card {
  height: 200rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(3, 62, 112, 0.05);
  display: flex;
  flex-direction: row;
  box-sizing: border-box;
}

.news-card--news {
  border-left: 8rpx solid #00467f;
}

.news-card__cover {
  position: relative;
  width: 34%;
  height: 100%;
  flex-shrink: 0;
  box-sizing: border-box;
}

.news-card__image {
  width: 100%;
  height: 100%;
  display: block;
  background: #f3f4f6;
}

.book-card {
  height: 228rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: row;
  border-radius: 8rpx 18rpx 18rpx 8rpx;
  overflow: hidden;
  background: #f6efe4;
  box-shadow: 0 10rpx 22rpx rgba(74, 37, 17, 0.16);
}

.book-card__spine {
  width: 46rpx;
  flex-shrink: 0;
  background: linear-gradient(90deg, #8a5a2b 0%, #e4a870 46%, #c4894a 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.book-card__spine-text {
  font-size: 16rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #4a2511;
  writing-mode: vertical-rl;
  line-height: 1.1;
}

.book-card__spine-text + .book-card__spine-text {
  margin-top: 14rpx;
}

.book-card__cover {
  position: relative;
  width: 34%;
  height: 100%;
  flex-shrink: 0;
  background: #1c140e;
}

.book-card__image {
  width: 100%;
  height: 100%;
  display: block;
}

.book-card__image--empty {
  background: #2a211b;
}

.book-card__gutter {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 18rpx;
  background: linear-gradient(90deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0));
}

.book-card__page {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx 16rpx 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  background:
    linear-gradient(90deg, rgba(138, 90, 43, 0.16), rgba(246, 239, 228, 0) 18rpx),
    #f6efe4;
}

.book-card__title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 700;
  color: #2b2118;
  line-height: 1.3;
}

.book-card__volume {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8a5a2b;
}

.book-card__issue {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4a2511;
}

.news-card__body {
  flex: 1;
  min-width: 0;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.news-card__badge {
  align-self: flex-start;
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 10rpx;
  padding: 3rpx 14rpx 3rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(0, 70, 127, 0.05);
  border: 1rpx solid rgba(0, 70, 127, 0.22);
}

.news-card__badge-mark {
  width: 8rpx;
  height: 8rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #00467f;
  flex-shrink: 0;
}

.news-card__badge-text {
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #00467f;
  line-height: 1.4;
}

.news-card__title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.news-card__date {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
}
