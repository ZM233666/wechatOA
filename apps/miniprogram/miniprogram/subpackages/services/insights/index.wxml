<view class="page page--insights {{readerVisible ? 'page--insights-reading' : ''}}">
  <nav-brand wx:if="{{!readerVisible}}" title="KB Insights" show-back="{{true}}"></nav-brand>

  <insight-reader
    wx:if="{{readerVisible}}"
    visible="{{true}}"
    report-id="{{readerReportId}}"
    has-nav-bar="{{false}}"
    bind:close="onReaderClose"
  ></insight-reader>

  <view wx:if="{{!readerVisible}}" class="insights">
    <empty-state wx:if="{{pageStatus === 'loading'}}" title="正在加载洞察"></empty-state>
    <empty-state wx:elif="{{pageStatus === 'empty'}}" title="{{emptyTitle || '更多内容，即将与你分享'}}" description="{{emptyDesc}}"></empty-state>
    <empty-state wx:elif="{{pageStatus === 'empty'}}" title="暂无洞察报告"></empty-state>

    <view wx:if="{{pageStatus === 'success'}}" class="insights__grid">
      <view
        class="insight-cover tap-feedback"
        wx:for="{{items}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-gating="{{item.gating}}"
        bindtap="onInsightTap"
      >
        <view class="insight-cover__frame">
          <view class="insight-cover__meta">
            <text class="insight-cover__kicker">{{item.kicker}}</text>
            <text class="insight-cover__name">{{item.title}}</text>
          </view>
          <image class="insight-cover__image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}"></image>
          <text wx:if="{{item.tag || item.pdfUrl}}" class="insight-cover__tag">{{item.tag || 'PDF'}}</text>
        </view>
      </view>
    </view>
  </view>
  <app-tab-bar></app-tab-bar>
</view>
